        // Wires one "🔊 <Provider> ▾" toggle button next to a Generate Audio button.
        function initGenSourceDropdown(toggleBtn, dropdownEl) {
            toggleBtn.innerHTML = '🔊 ' + shortProviderLabel(settings.ttsProvider || 'voicerss') + ' ▾';
            toggleBtn.onclick = () => {
