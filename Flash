                toggleBtn.setAttribute('aria-expanded', String(willOpen));
            };
        }

        // Registered once: clicking anywhere outside an open POS dropdown's own field
        // collapses it back up again (capture phase so it runs before the toggle button's
        // own click handler, which correctly re-opens a dropdown that was just closed).
        document.addEventListener('click', (e) => {
            document.querySelectorAll('.pos-dropdown.open').forEach(dd => {
                const field = dd.closest('.add-word-field');
