                if (cb) cb(); });
            // Study/Browse navigate to a full-screen view rendered behind
            // any still-open overlay (like the Folders list this action
            // sheet was opened from) — so those must be closed too, not
            // just this action sheet, or the new screen stays hidden
            // until the user manually closes the leftover overlay.
            const closeAllFolderOverlays = (cb) => {
                const foldersModalEl = document.getElementById('foldersModal');
                if (foldersModalEl) {
                    closeModalAnimated(foldersModalEl, () => { foldersModalEl.remove();
                        if (cb) cb(); });
