                  <button class="btn-ghost" id="cancelFolderBtn" style="margin:0;">Cancel</button>
                  <button class="btn-main" id="saveFolderBtn" style="margin:0;">${isNew?'Create Folder':'Save Changes'}</button>
                </div>
              </div>`;
            document.body.appendChild(modal);
            modal.querySelectorAll('.dir-option-chip').forEach(btn => {
                btn.onclick = () => {
                    selectedDirection = btn.dataset.dir;
                    modal.querySelectorAll('.dir-option-chip').forEach(b => b.classList.toggle('selected', b.dataset.dir === selectedDirection));
                };
            });
            document.getElementById('cancelFolderBtn').onclick = () => closeModalAnimated(modal, () => modal.remove());
            document.getElementById('saveFolderBtn').onclick = async () => {
                const name = document.getElementById('folderNameInput').value.trim();
                if (!name) { showInfoModal('⚠️', 'Name required', 'Give the folder a name first.', 'var(--hard)');
                    return; }
                if (isNew) {
                    customFolders.push({ id: makeUniqueFolderId(), name, direction: selectedDirection, createdAt: Date.now() });
                } else {
                    folder.name = name;
                    folder.direction = selectedDirection;
                }
                await saveCustomFolders();
                closeModalAnimated(modal, () => { modal.remove();
                    if (onSaved) onSaved(); });
            };
