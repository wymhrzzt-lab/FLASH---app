                    // Which face is now showing may depend on the global AR<->EN
                    // direction OR a per-folder override (see buildCardFaceHtml),
                    // so always ask it which side currently holds the English
                    // word/speak-button rather than assuming "back = English".
                    // Each side also has its OWN audio key — 'audioFront' for
                    // the front side of an en2en (opposites/synonyms) card,
                    // 'audio' everywhere else — so read the key the currently
                    // showing side actually owns instead of always reading
                    // '.audio' (which used to play the BACK word's audio even
                    // while the FRONT side was the one showing on en2en cards).
                    const face = buildCardFaceHtml(card);
                    const showingEnglishSide = flipped ? face.backShowSpeak : face.frontShowSpeak;
                    const audioKey = flipped ? (face.backAudioKey || 'audio') : (face.frontAudioKey || 'audio');
                    const audioUrl = showingEnglishSide && mediaFor(card.id)[audioKey];
                    if (audioUrl) playCustomAudio(audioUrl);
                }
            }
