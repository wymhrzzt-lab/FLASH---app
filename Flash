        // Small themed action-sheet for a folder row: study just this
        // folder's cards, browse them, edit the folder's layout settings,
        // or delete it — replaces the old behavior of jumping straight into
        // the edit form when a folder was tapped.
        function showFolderActionsModal(folder, refreshList) {
            if (document.getElementById('folderActionsModal')) return;
            const modal = document.createElement('div');
            modal.className = 'add-word-modal';
            modal.id = 'folderActionsModal';
