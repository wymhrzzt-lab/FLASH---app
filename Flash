                    updated.frontPos = v.frontPos;
                    updated.frontIpa = normalizeIpaInput(v.frontIpa);
                    updated.frontExEn = v.frontExEn;
                    updated.frontExAr = v.frontExAr;
                    updated.direction = selectedType;
