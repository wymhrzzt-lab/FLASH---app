        .gen-btn-group .gen-source-caret { margin:0; border-radius:0 999px 999px 0; border-left:1px solid rgba(224,167,66,.45); padding:6px 9px; }
        .gen-source-caret { font-family:'Inter',sans-serif; font-size:12px; font-weight:700; color:var(--amber); background:rgba(224,167,66,.12); border:1px solid rgba(224,167,66,.35); border-radius:999px; padding:6px 10px; margin-top:8px; display:inline-flex; align-items:center; justify-content:center; line-height:1; }
        .front-audio-actions .gen-source-caret { margin-top:0; }
