                </div>
                <div class="am-fetch-status">
                  <span class="dot ${st.status === 'running' ? 'running' : st.status === 'complete' ? 'done' : 'idle'}"></span>
                  ${st.status === 'running' ? `Processing ${st.processedIds.length}/${st.selectedIds.length} words…` :
                    st.status === 'complete' && st.summary ? `${st.summary.success} ready, ${st.summary.failed} failed, ${st.summary.skipped} skipped` :
                    'Ready — tap Start to fetch missing audio'}
