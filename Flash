        /* ========================= GLOBAL MODAL ANIMATIONS ========================= */
        @keyframes modalBackdropIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes modalCardIn {
            from { opacity: 0; transform: translateY(14px) scale(.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Every program popup gets the same soft entrance animation. */
        body > div[style*="position:fixed"] {
            animation: modalBackdropIn .24s ease-out both;
            z-index: 10020 !important;
        }

        body > div[style*="position:fixed"] > div {
            animation: modalCardIn .34s cubic-bezier(.22,1,.36,1) both;
            will-change: transform, opacity;
        }

        .am-modal, .fetch-modal, .genLoadingModal {
            animation: modalBackdropIn .24s ease-out both;
        }

        .am-modal > .am-card,
        .fetch-modal > .fetch-card,
        .genLoadingModal > div {
            animation: modalCardIn .34s cubic-bezier(.22,1,.36,1) both;
            will-change: transform, opacity;
        }

        /* Information / confirmation dialogs must sit above the modal that opened them. */
        #infoModal, #resetModal { z-index: 10030 !important; }

        @keyframes modalBackdropOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }

        @keyframes modalCardOut {
            from { opacity: 1; transform: translateY(0) scale(1); }
            to { opacity: 0; transform: translateY(8px) scale(.97); }
        }

        /* ========================= FLEXIBLE CARD CONTENT ========================= */
        .face.front, .face.back { overflow: hidden; }
        .front-content, .back-content { position:relative; width:100%; height:100%; min-height:0; overflow-y:auto; overscroll-behavior:contain; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:8px; scrollbar-width:thin; }
        .scroll-hint {
            position: sticky;
            bottom: 2px;
            align-self: center;
            width: 26px;
            height: 16px;
            border-radius: 8px;
            background: rgba(0,0,0,.35);
            color: var(--dim);
            font-size: 13px;
            line-height: 16px;
            text-align: center;
            pointer-events: none;
            flex-shrink: 0;
            animation: scrollHintBob 1.4s ease-in-out infinite;
            transition: opacity .2s ease;
            z-index: 1;
        }
        .scroll-hint.hidden { opacity: 0; }
        @keyframes scrollHintBob {
            0%, 100% { transform: translateY(0); opacity: .7; }
            50% { transform: translateY(3px); opacity: 1; }
        }
        .front-content { padding:4px 0 28px; gap:9px; }
        .front-media-slot { width:100%; min-height:130px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .front-media-box { width:100%; height:100%; display:flex; align-items:center; justify-content:center; position:relative; }
        .custom-img-wrap { position:relative; width:100%; height:100%; max-width:100%; max-height:100%; margin:0; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .custom-img { display:block; width:auto; height:auto; max-width:100%; max-height:100%; object-fit:contain; border-radius:16px; border:1px solid var(--line); cursor:zoom-in; }
        .front-media-box .img-slot { width:150px; height:150px; margin:0; }
        /* Dedicated, always-centered slot for the front word so it never gets squeezed between the media and the action pills. */
        .front-word-slot { width:100%; flex:1 0 auto; min-height:64px; display:flex; align-items:center; justify-content:center; }
        .front-word { width:100%; max-width:100%; text-align:center; overflow-wrap:anywhere; word-break:break-word; flex-shrink:0; }
        /* Fixed row of pill actions (Photo / Audio / Generate), always in the same spot at the bottom of the front face. */
        .front-audio-actions { width:100%; display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:6px; flex-shrink:0; margin-top:auto; }
        .front-audio-actions .audio-link { margin-top:0; }
        .back-audio-actions { margin-top:auto; }
        .front-hint { bottom:10px; z-index:2; }
        .face.back { justify-content:flex-start; align-items:stretch; padding:20px 22px 18px; }
        .back-content { padding:8px 0; }
        /* Mirrors .front-word-slot: grows to absorb the leftover vertical
           space and centers the answer (word + IPA + example) inside it, so
           the back face lines up with the front face instead of sticking to
           the top with a big empty gap above the audio buttons. */
        .back-middle { width:100%; flex:1 0 auto; min-height:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; }
        /* Plain centered column: POS (if any) above, then the word itself
           (wrapped in .word-freeze-boundary, see below), then IPA (if any)
           below. No grid, no shared row with the speak button any more —
           see .corner-speak-btn — so this block's height can grow to
           whatever the word needs without dragging the button along. */
        .back-identity {
            width:100%;
            min-width:0;
            text-align:center;
            display:flex;
            flex-direction:column;
            align-items:center;
            gap:6px;
            flex-shrink:0;
        }
        /* Reserved top clearance, added to .back-identity only when a
           corner speak button is rendered on that face (see the templates
           that add this class alongside "back-identity") — pushes all
           content below the button's row instead of squeezing every
           line's width to dodge it horizontally, so long text still gets
           the card's full width to wrap in. */
        .identity-gutter { padding: 52px 10px 0; }
        .pos-inline {
            font-family:'IBM Plex Mono',monospace;
            font-size:12px;
            color:var(--teal);
            background:rgba(79,179,169,.12);
            border:1px solid rgba(79,179,169,.3);
            padding:3px 8px;
            border-radius:7px;
            flex:0 0 auto;
        }
        /* The ONLY element that may ever grow a private scrollbar (see the
           "last resort" freeze in shrinkToFit). Kept as a tight wrapper
           around just the word/expression text — POS and IPA are its
           siblings inside .back-identity, never its descendants — so a
           pathologically long word/article can scroll internally without
           ever pulling POS/IPA/the speak button along with it. */
        .word-freeze-boundary { width:100%; min-width:0; }
        .en-word {
            font-size:30px;
            line-height:1.05;
            overflow-wrap:anywhere;
            word-break:break-word;
            text-align:center;
            max-width:100%;
        }
        .back-identity .ipa {
            margin:0;
            text-align:center;
            max-width:100%;
            overflow-wrap:anywhere;
            word-break:break-word;
        }
        /* Fixed overlay, positioned relative to .face (which is
           position:absolute; inset:0 — see above), NOT inside the
           scrollable .front-content/.back-content. This is what makes the
           button's position independent of word length: it never sits
           inside a flex row that can stretch to match a frozen scrolling
           slot's height, so it can never end up floating mid-scroll over
           the text (the bug from the previous version). */
        .corner-speak-btn {
