                const includeImage = !isExtraCard || selectedType !== 'en2en';
                const includeAudioFront = isExtraCard && selectedType === 'en2en';
                if (isCustomCard(card)) {
                    const target=customWords.find(c=>c.id===card.id);
                    if (target) {
                        Object.assign(target, updated);
                        const folderSel = q('editFolderId');
                        if (folderSel) {
                            const newFolderId = folderSel.value || null;
                            // Only re-freeze the layout from the folder when the
                            // folder assignment actually changes here — re-saving
                            // the same card without moving it must never silently
                            // re-snapshot a folder setting someone changed since.
                            // The explicit type picker above is the source of
                            // truth otherwise (already applied via updated.direction).
                            if (newFolderId !== (target.folderId || null)) {
                                if (newFolderId) {
                                    target.folderId = newFolderId;
                                    const fld = customFolders.find(f => f.id === newFolderId);
                                    target.direction = (fld && fld.direction) || selectedType;
                                } else {
                                    delete target.folderId;
                                }
                            }
                        }
                    }
                    await saveCustomWords();
                } else {
                    cardEdits[card.id] = { ...(cardEdits[card.id]||{}), ...updated };
                    await saveCardEdits();
                }

                if (!customMedia[card.id]) customMedia[card.id]={};
                if (removeImg || !includeImage) delete customMedia[card.id].img;
                else if (draftImg) customMedia[card.id].img=draftImg;
                if (removeAudio) delete customMedia[card.id].audio;
                else if (draftAudio) {
                    customMedia[card.id].audio=draftAudio;
                    customMedia[card.id].audioMode='offline';
                    customMedia[card.id].audioTerm=updated.en || card.en || '';
                }
                if (removeAudioFront || !includeAudioFront) delete customMedia[card.id].audioFront;
                else if (draftAudioFront) customMedia[card.id].audioFront=draftAudioFront;
                await saveMedia();

                const freshCard=CARDS().find(c=>c.id===card.id) || { ...card, ...updated };
                closeModalAnimated(modal, ()=>{
                    const browseModal=document.getElementById('browseModal');
                    if (browseModal) {
                        browseModal.remove();
                        window._refreshBrowseModal = null;
                        document.body.style.overflow='';
                        showBrowseCardModal(freshCard);
                    } else {
                        renderBrowse();
                    }
                });
            };
        }

