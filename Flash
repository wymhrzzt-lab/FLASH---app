        async function showAddWordModal(presetFolderId) {
            const isExtra = level === 'Extra';
            if (document.getElementById('addWordModal')) return;
            let draftImg = null, draftAudio = null, draftAudioFront = null;
            const presetFolder = presetFolderId ? customFolders.find(f => f.id === presetFolderId) : null;
            let selectedType = isExtra ? ((presetFolder && presetFolder.direction) || 'ar2en') : 'ar2en';
