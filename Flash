        async function showFolderEditModal(folder, onSaved) {
            if (document.getElementById('folderEditModal')) return;
            const isNew = !folder;
            let selectedDirection = (folder && folder.direction) || 'ar2en';
            const modal = document.createElement('div');
            modal.className = 'add-word-modal';
            modal.id = 'folderEditModal';
            modal.style.zIndex = '10040';

            function chipsHtml() {
                return FOLDER_DIRECTIONS.map(d => `
                  <button type="button" class="dir-option-chip${d.id===selectedDirection?' selected':''}" data-dir="${d.id}">
                    <span class="dir-ico">${d.icon}</span>
                    <span class="dir-txt"><span class="dir-title">${escHtml(d.title)}</span><span class="dir-sub">${escHtml(d.sub)}</span></span>
                    <span class="dir-check">✓</span>
                  </button>`).join('');
            }

            modal.innerHTML = `
              <div class="add-word-card">
                <h3 class="add-word-title">${isNew ? '📁 New Folder' : '✏️ Edit Folder'}</h3>
                <div class="add-word-sub">Choose what shows on the front and back of cards in this folder. This only affects this folder — it won't change the app's main study direction.</div>
