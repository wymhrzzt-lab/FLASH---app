        /* ========================= V28: front layout order / button row / auto-fit ========================= */
        /* Word sits near the top (not glued to the edge) when there's a photo/emoji,
           and the image owns the middle region below it — buttons stay pinned at the bottom. */
        .front-content.has-media { justify-content:flex-start; }
        .front-content.has-media .front-word-slot { flex:0 0 auto; min-height:0; padding-top:10px; }
        .front-content.has-media .front-media-slot { flex:1 1 auto; height:auto; min-height:96px; }
        /* When a photo AND an example sentence share the face, the photo
           gives up space first — the example text is what the person is
           studying, so it gets priority over the image's usual size. */
        .front-media-slot.compact { flex:0 1 auto; min-height:64px; }
        .front-media-slot.compact .front-media-box { width:120px; height:64px; }
        .front-media-slot.compact .front-media-box .img-slot,
        .front-media-slot.compact .custom-img { max-width:110px; max-height:64px; }
        /* No photo/emoji: the word owns the full middle of the face, clearly centered. */
        .front-content:not(.has-media) .front-word-slot { flex:1 0 auto; }
        /* Anti-overlap fix: this slot must never grow past the space the flex
           layout actually gives it, or long text spills onto the photo/audio
           buttons pinned right below it. min-height:0 lets it take exactly
           its fair share (a real, bounded box) instead of forcing itself
           taller to fit content.
           IMPORTANT: no overflow-y:auto here. .front-content (the ancestor)
           is already the one-and-only scroll container for this face —
           shrinkToFit() measures overflow against it. A second scrollable
           box nested inside it would quietly absorb any overflow itself,
           so the outer box would never register as overflowing and the
           font would never shrink (it would just get clipped/cropped
           instead). Keeping exactly one scroll container per face — same
           as the back face already does — is what makes the shrink-to-fit
           work consistently on both faces, in both AR/EN directions, no
           matter how long the text is. */
        .front-content:not(.has-media) .front-word-slot { min-height:0; }

        /* Photo/Generate/Audio pills always stay on one line. */
        .front-audio-actions { flex-wrap:nowrap; }
        .front-audio-actions .audio-link { padding:6px 10px; font-size:11px; white-space:nowrap; flex:0 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; }
        /* The Generate+caret group is itself one flex item of that row, so it needs
           the same shrink/min-width treatment — otherwise it ignores the row's
           nowrap sizing and its own children overflow past the card edge. */
        .front-audio-actions .gen-btn-group { flex:0 1 auto; min-width:0; max-width:100%; }
        .front-audio-actions .gen-btn-group .gen-main { flex:1 1 auto; min-width:0; }
        .front-audio-actions .gen-btn-group .gen-source-caret { flex:0 0 auto; }

        /* Long word/expression text shrinks via JS (auto-fit-text) instead of scrolling. */
        .auto-fit-text { max-height:none !important; overflow:visible !important; white-space:normal; }
    /* ========================= CENTER-ALIGNMENT HARDENING =========================
       Forces the word/expression, POS chip, and IPA line shown on a
       flashcard's front or back face to be perfectly horizontally
       centered, no matter its text direction (LTR/RTL). Uses ".face ..."
       (two classes) plus !important so this always wins over ".rtl"'s
       text-align:right, regardless of stylesheet order or any future rule
       added above. Deliberately scoped to ".face" (the card faces only) so
       RTL input fields elsewhere (the Add/Edit Word forms, the search box)
       keep their correct right-aligned typing behavior, and deliberately
       excludes ".example" (the quoted example-sentence block), which is
       intentionally left/right-aligned like a normal paragraph with its
       accent border, not centered. */
    .face .front-word,
    .face .ar-word,
    .face .en-word,
    .face .back-identity,
    .face .word-freeze-boundary,
    .face .pos-pill,
    .face .pos-inline,
    .face .ipa,
    .face .ipa-line,
    .face .blank-back-note {
        text-align: center !important;
    }
    /* Belt-and-suspenders: center these boxes as flex containers too, so
       centering never depends on text-align alone. */
    .face .front-word-slot,
    .face .back-identity {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
    }
