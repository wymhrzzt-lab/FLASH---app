            if (isExtra) {
                modal.querySelectorAll('#newTypeChips .dir-option-chip').forEach(btn => { btn.onclick = () => selectType(btn.dataset.dir); });
                const folderSel = q('newFolderId');
                folderSel.onchange = () => {
                    const fld = folderSel.value ? customFolders.find(f => f.id === folderSel.value) : null;
                    const chipsWrap = q('newTypeChips');
                    q('newTypeLockNote').style.display = fld ? 'block' : 'none';
                    if (chipsWrap) { chipsWrap.style.opacity = fld ? '.55' : ''; chipsWrap.style.pointerEvents = fld ? 'none' : ''; }
                    selectType((fld && fld.direction) || (fld ? 'ar2en' : selectedType));
                };
            }
            q('cancelAddWord').onclick=()=>closeModalAnimated(modal);
            q('saveAddWord').onclick=async()=>{
                captureValues();
                const { ar, en, pos, ipa, exEn, exAr, frontPos, frontIpa, frontExEn, frontExAr } = v;
                const ipaClean = normalizeIpaInput(ipa), frontIpaClean = normalizeIpaInput(frontIpa);
                if(!isExtra && (!ar || !en)){showInfoModal('⚠️','Two fields required','For a normal level, enter Arabic for the front and English for the back.','var(--hard)');return;}
                const includeImage = selectedType !== 'en2en';
                const includeAudioFront = selectedType === 'en2en';
                if(isExtra && !ar && !en && !pos && !ipaClean && !exEn && !exAr && !frontPos && !frontIpaClean && !frontExEn && !frontExAr && !(includeImage&&draftImg) && !draftAudio && !(includeAudioFront&&draftAudioFront)){showInfoModal('⚠️','Nothing to save','Add at least one item to the card.','var(--hard)');return;}
                const card={n:(DATA[lang][level]||[]).length+customWords.length+1,id:makeUniqueCustomId(),en,ar,pos,ipa:ipaClean,exEn,exAr,tags:[],_custom:true};
                if (isExtra) {
                    if (frontPos) card.frontPos = frontPos;
                    if (frontIpaClean) card.frontIpa = frontIpaClean;
                    if (frontExEn) card.frontExEn = frontExEn;
                    if (frontExAr) card.frontExAr = frontExAr;
                    card.direction = selectedType;
                    const folderSel = q('newFolderId');
                    if (folderSel && folderSel.value) {
                        card.folderId = folderSel.value;
                        // Freeze a copy of the folder's CURRENT layout onto this
                        // card. Later changes to the folder's settings only
                        // apply to cards added after that point (see cardDirection).
                        const fld = customFolders.find(f => f.id === folderSel.value);
                        card.direction = (fld && fld.direction) || selectedType;
                    } }
                customWords.push(card); await saveCustomWords();
                const saveImg = includeImage && draftImg, saveAudioFront = includeAudioFront && draftAudioFront;
                if(saveImg || draftAudio || saveAudioFront){customMedia[card.id]=customMedia[card.id]||{};if(saveImg)customMedia[card.id].img=draftImg;if(draftAudio){customMedia[card.id].audio=draftAudio;customMedia[card.id].audioMode='offline';}if(saveAudioFront){customMedia[card.id].audioFront=draftAudioFront;}await saveMedia();}
                const savedFolderId = card.folderId || null;
                closeModalAnimated(modal,()=>{
                    const fld = savedFolderId && customFolders.find(f => f.id === savedFolderId);
                    if (fld) { renderDashboard(); showFolderActionsModal(fld, () => {}); }
                    else renderDashboard();
                });
            };
        }

        function renderSummary() {
            stopCustomAudio();
            stopTimer();
            screen = 'summary';
            app.innerHTML = `
            <div class="summary">
              <div class="emo">🌙</div>
              <h1>Session Complete</h1>
              <div class="sub">You reviewed ${sessionReviewed} cards in ${level}</div>
              <div class="summary-stats">
                <div class="stat"><b>${stats.reviewedIds.length}</b><span>Total today</span></div>
                <div class="stat"><b>${Object.keys(progress).length}/${CARDS().length}</b><span>Started</span></div>
              </div>
              <button class="btn-main" id="homeBtn">Back to Dashboard</button>
              <div class="rest-note">Learning-phase cards (due in minutes) will reappear automatically if you keep studying today</div>
            </div>
          `;
            document.getElementById('homeBtn').onclick = renderDashboard;
        }

        function renderBrowse(presetFolderId) {
            stopCustomAudio();
            screen = 'browse';
            pushHistoryIfNeeded('browse');
            app.innerHTML = `
            <div class="topbar">
              <button class="back-arrow" id="backArrow">←</button>
              <div class="eyebrow" style="margin-bottom:0;">${lang} · ${level} · ${CARDS().length} words</div>
            </div>
            <h1>All Words</h1>
            <input class="search" id="searchInput" placeholder="Search in Arabic or English...">
            ${(level === 'Extra' && customFolders.length) ? `<select class="add-word-input" id="folderFilterSelect" style="margin-bottom:10px;">
              <option value="">All folders</option>
              <option value="__unfiled__">Unfiled</option>
              ${customFolders.map(f => `<option value="${f.id}" ${presetFolderId===f.id?'selected':''}>📁 ${escHtml(f.name)}</option>`).join('')}
            </select>` : ''}
            <div class="browse-toolbar">
              <label class="browse-select-all"><input type="checkbox" id="selectAllCustom"> <span>Select all custom</span></label>
              <button class="browse-delete-selected" id="deleteSelectedBtn">🗑 Delete selected</button>
            </div>
            <div class="browse-list" id="list"></div>
          `;
            document.getElementById('backArrow').onclick = () => history.back();
            const list = document.getElementById('list');
            const selectAll = document.getElementById('selectAllCustom');
            const deleteSelected = document.getElementById('deleteSelectedBtn');
            const selectedIds = new Set();

            function syncSelectAll(items) {
                const customVisible = items.filter(c => isCustomCard(c));
                selectAll.checked = customVisible.length > 0 && customVisible.every(c => selectedIds.has(c.id));
                selectAll.indeterminate = customVisible.some(c => selectedIds.has(c.id)) && !selectAll.checked;
                deleteSelected.disabled = selectedIds.size === 0;
                deleteSelected.style.opacity = selectedIds.size ? '1' : '.45';
            }

            function draw(filter) {
                const f = (filter || '').trim().toLowerCase();
                const folderSel = document.getElementById('folderFilterSelect');
                const folderFilter = folderSel ? folderSel.value : '';
                let items = CARDS().filter(c => !f || String(c.ar||'').includes(f) || String(c.en||'').toLowerCase().includes(f));
                if (folderFilter === '__unfiled__') items = items.filter(c => !c.folderId);
                else if (folderFilter) items = items.filter(c => c.folderId === folderFilter);
                list.innerHTML = items.map(c => `
              <div class="brow" data-id="${c.id}">
                <div class="n">#${c.n}</div>
                <div class="e"></div>
                <div class="ar rtl">${escHtml(c.ar || '')}</div>
                <div class="en">${escHtml(c.en || '')}${c.pos ? ' ('+escHtml(c.pos)+')' : ''}</div>
                ${isCustomCard(c) ? `<div class="brow-tools"><input class="brow-check" type="checkbox" aria-label="Select card" ${selectedIds.has(c.id)?'checked':''}><button class="brow-delete" type="button" aria-label="Delete card">🗑</button></div>` : ''}
              </div>
            `).join('') || '<div class="empty-note">No matching words.</div>';

                list.querySelectorAll('.brow').forEach(el => {
                    const id = el.dataset.id;
                    const card = CARDS().find(c => c.id === id);
                    const check = el.querySelector('.brow-check');
                    const del = el.querySelector('.brow-delete');
                    if (check) check.onchange = (e) => { e.stopPropagation(); if (check.checked) selectedIds.add(id); else selectedIds.delete(id); syncSelectAll(items); };
                    if (del) del.onclick = (e) => { e.stopPropagation(); showDeleteCardsConfirm([id]); };
                    el.onclick = (e) => {
                        if (e.target === check || e.target === del || (e.target && e.target.closest('.brow-tools'))) return;
                        if (card) showBrowseCardModal(card);
                    };
                });
                syncSelectAll(items);
            }

            selectAll.onchange = () => {
                const f = document.getElementById('searchInput').value.trim().toLowerCase();
                const visibleCustom = CARDS().filter(c => isCustomCard(c) && (!f || String(c.ar||'').includes(f) || String(c.en||'').toLowerCase().includes(f)));
                visibleCustom.forEach(c => selectAll.checked ? selectedIds.add(c.id) : selectedIds.delete(c.id));
                draw(f);
            };
            deleteSelected.onclick = () => showDeleteCardsConfirm([...selectedIds]);
            draw('');
            document.getElementById('searchInput').oninput = (e) => draw(e.target.value);
            const folderFilterSelect = document.getElementById('folderFilterSelect');
            if (folderFilterSelect) folderFilterSelect.onchange = () => draw(document.getElementById('searchInput').value);
        }

        function showBrowseCardModal(card) {
            let isModalFlipped = false;

            function flipModalCard() {
                stopCustomAudio();
                isModalFlipped = !isModalFlipped;
                const inner = document.getElementById('modalCardInner');
                if (inner) inner.classList.toggle('flipped', isModalFlipped);
                const rate = document.getElementById('modalHint');
                if (rate) rate.style.display = isModalFlipped ? 'none' : 'block';
                if (settings.autoPlayAudio) {
                    const face = buildCardFaceHtml(card);
                    const showingEnglishSide = isModalFlipped ? face.backShowSpeak : face.frontShowSpeak;
                    const audioKey = isModalFlipped ? (face.backAudioKey || 'audio') : (face.frontAudioKey || 'audio');
                    const audioUrl = showingEnglishSide && mediaFor(card.id)[audioKey];
                    if (audioUrl) playCustomAudio(audioUrl);
                }
            }

            let modal = document.getElementById('browseModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'browseModal';
                modal.style.cssText =
                    'position:fixed;inset:0;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:10020;padding:16px;';
                document.body.appendChild(modal);
            }

            function renderModalCard() {
                const _face = buildCardFaceHtml(card);
                // Same reasoning as renderStudy: every direction except
                // 'en2en' has exactly one rich (audio) face at a time, so it
                // shares the plain 'audio' key/ids. 'en2en' has BOTH faces
                // rich simultaneously, so it needs its own key/ids for the
                // front to avoid colliding with the back's.
                const frontAudioKey = _face.frontAudioKey || 'audio';
                const backAudioKey = _face.backAudioKey || 'audio';
                const frontIds = _face.frontIds || { removeAudio: 'modalRemoveAudioBtn', generateAudio: 'modalGenerateAudioBtn', genCaret: 'modalGenSourceCaretBtn', addAudio: 'modalAddAudioBtn' };
                const backIds = _face.backIds || { removeAudio: 'modalRemoveAudioBtn', generateAudio: 'modalGenerateAudioBtn', genCaret: 'modalGenSourceCaretBtn', addAudio: 'modalAddAudioBtn' };
                modal.innerHTML = `
              <div style="width:100%;max-width:380px;">
                <div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
                  <button class="dir-toggle-btn" id="modalDirToggleBtn" title="Switch AR↔EN direction">⇄ ${studyDirLabel()}</button>
                </div>
                <div class="stage" style="height:380px;margin-bottom:12px;">
                  <div class="card-outer">
                    <div class="card ${isModalFlipped ? 'flipped' : ''}" id="modalCardInner">
                      <div class="face front">
                        ${(_face.frontShowSpeak && mediaFor(card.id)[frontAudioKey]) ? `<button class="speak-btn corner-speak-btn" id="modalFrontSpeakBtn"></button>` : ''}
                        ${_face.frontShowSpeak
                            ? buildRichUnitHtml(card, _face.frontWordHtml, _face.frontExampleHtml, true, frontIds, frontAudioKey, _face.frontHasContent)
                            : buildPhotoUnitHtml(card, _face.frontWordHtml, {img:'modalCustomImg', removeImg:'modalRemoveImgBtn', addImg:'modalAddImgBtn'})}
                      </div>
                      <div class="face back">
                        ${(_face.backShowSpeak && mediaFor(card.id)[backAudioKey]) ? `<button class="speak-btn corner-speak-btn" id="modalSpeakBtn"></button>` : ''}
                        ${_face.backShowSpeak
                            ? buildRichUnitHtml(card, _face.backIdentityHtml, _face.backExampleHtml, true, backIds, backAudioKey, _face.backHasContent)
                            : buildPhotoUnitHtml(card, _face.backIdentityHtml, {img:'modalCustomImg', removeImg:'modalRemoveImgBtn', addImg:'modalAddImgBtn'})}
                      </div>                    </div>
                  </div>
                </div>
                <div class="modal-edit-row">
                  <button class="btn-ghost" id="modalEditCardBtn" style="margin:0;border-color:rgba(224,167,66,.35);color:var(--amber);">✏️ Edit Card</button>
                  ${isCustomCard(card) ? `<button class="btn-ghost" id="modalDeleteCardBtn" style="margin:0;border-color:rgba(195,86,79,.35);color:var(--again);">🗑 Delete</button>` : ''}
                  <button class="btn-ghost" id="closeBrowseModalBtn" style="margin:0;border-color:transparent;color:var(--amber);">Close</button>
                </div>
              </div>
            `;
                const modalDirToggleBtn = document.getElementById('modalDirToggleBtn');
                if (modalDirToggleBtn) modalDirToggleBtn.onclick = (e) => { e.stopPropagation();
                    confirmSwapDirection(() => renderModalCard()); };

                document.getElementById('modalCardInner').onclick = flipModalCard;
                autoFitCardFaces(document.getElementById('modalCardInner'));

                const spk = document.getElementById('modalSpeakBtn');
                if (spk) spk.onclick = (e) => { e.stopPropagation();
                    if (!isModalFlipped) return;
                    playCustomAudio(mediaFor(card.id)[backAudioKey]); };
                const frontSpk = document.getElementById('modalFrontSpeakBtn');
                if (frontSpk) frontSpk.onclick = (e) => { e.stopPropagation();
                    if (isModalFlipped) return;
                    playCustomAudio(mediaFor(card.id)[frontAudioKey]); };

                const addImgBtn = document.getElementById('modalAddImgBtn');
                if (addImgBtn) addImgBtn.onclick = (e) => { e.stopPropagation();
                    addImage(card.id); };
                const removeImgBtn = document.getElementById('modalRemoveImgBtn');
                if (removeImgBtn) removeImgBtn.onclick = (e) => { e.stopPropagation();
                    removeImageConfirm(card.id); };
                const modalCustomImg = document.getElementById('modalCustomImg');
                if (modalCustomImg) modalCustomImg.onclick = (e) => { e.stopPropagation();
                    openImageZoom(modalCustomImg.src); };
                // Back face's audio controls (word = card.en, key = backAudioKey — 'audio' for every direction).
                const addAudioBtn = document.getElementById(backIds.addAudio);
                if (addAudioBtn) addAudioBtn.onclick = (e) => { e.stopPropagation();
                    addAudio(card.id, backAudioKey); };
                const generateAudioBtn = document.getElementById(backIds.generateAudio);
                if (generateAudioBtn) generateAudioBtn.onclick = (e) => { e.stopPropagation();
                    generateAudioForCard(card.id, card.en, backAudioKey); };
                const modalGenSourceCaretBtn = document.getElementById(backIds.genCaret);
                if (modalGenSourceCaretBtn) modalGenSourceCaretBtn.onclick = (e) => { e.stopPropagation();
                    toggleGenSourcePopover(modalGenSourceCaretBtn); };
                const removeAudioBtn = document.getElementById(backIds.removeAudio);
                if (removeAudioBtn) removeAudioBtn.onclick = (e) => { e.stopPropagation();
                    removeAudioConfirm(card.id, backAudioKey); };
                // Front face's own audio controls — only distinct from the
                // back's when the card's direction is 'en2en' (frontIds
                // differ from backIds then; every other direction reuses the
                // same id STRINGS here, so this must compare the actual id
                // values, not object identity — frontIds/backIds are always
                // two separate object literals even when their contents
                // match, so `!==` was always true and this block always ran,
                // re-finding the single real (back) button by its shared id
                // string and rebinding it to the wrong word (card.ar) and the
                // wrong shared audio key).
                if (frontIds.generateAudio !== backIds.generateAudio) {
                    const addAudioFrontBtn = document.getElementById(frontIds.addAudio);
                    if (addAudioFrontBtn) addAudioFrontBtn.onclick = (e) => { e.stopPropagation();
                        addAudio(card.id, frontAudioKey); };
                    const generateAudioFrontBtn = document.getElementById(frontIds.generateAudio);
                    if (generateAudioFrontBtn) generateAudioFrontBtn.onclick = (e) => { e.stopPropagation();
                        generateAudioForCard(card.id, card.ar, frontAudioKey); };
                    const genSourceCaretFrontBtn = document.getElementById(frontIds.genCaret);
                    if (genSourceCaretFrontBtn) genSourceCaretFrontBtn.onclick = (e) => { e.stopPropagation();
                        toggleGenSourcePopover(genSourceCaretFrontBtn); };
                    const removeAudioFrontBtn = document.getElementById(frontIds.removeAudio);
                    if (removeAudioFrontBtn) removeAudioFrontBtn.onclick = (e) => { e.stopPropagation();
                        removeAudioConfirm(card.id, frontAudioKey); };
                }

                document.getElementById('closeBrowseModalBtn').onclick = () => {
                    stopCustomAudio();
                    closeModalAnimated(modal, () => {
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                    });
                };
                const modalEditBtn = document.getElementById('modalEditCardBtn');
                if (modalEditBtn) modalEditBtn.onclick = (e) => { e.stopPropagation(); showEditCardModal(card); };
                const modalDeleteBtn = document.getElementById('modalDeleteCardBtn');
                if (modalDeleteBtn) modalDeleteBtn.onclick = (e) => { e.stopPropagation(); showDeleteCardsConfirm([card.id], true); };

            }

            window._refreshBrowseModal = renderModalCard;
            document.body.style.overflow = 'hidden';
            modal.style.display = 'flex';
            renderModalCard();
        }

        // ============================================================
        // START
        // ============================================================
        init();
    </script>
</body>
</html>
