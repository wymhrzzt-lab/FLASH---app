        // ============================================================
        // CORE SCHEDULING & STUDY
        // ============================================================
        function dueCards() { const t = now(); return CARDS().filter(c => progress[c.id] && progress[c.id].due <= t); }

        function newCards() { return CARDS().filter(c => !progress[c.id]); }

        function shuffle(arr) { const a = [...arr]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() *
                    (i + 1));
                [a[i], a[j]] = [a[j], a[i]]; } return a; }

        function buildQueue(isExtra = false, folderId = null) {
            // folderId optionally scopes the session to one Extra folder's
            // cards only (see studyFolder) — same due/new/cram logic as a
            // normal session, just narrowed to that folder's pool first.
            const pool = folderId ? CARDS().filter(c => c.folderId === folderId) : CARDS();
            if (isExtra) {
                queue = shuffle(pool.filter(c => progress[c.id])).slice(0, settings.sessionSize);
            } else {
                const due = shuffle(pool.filter(c => progress[c.id] && progress[c.id].due <= now()));
                const capped = due.slice(0, settings.sessionSize);
                const remainingSlots = Math.max(0, settings.sessionSize - capped.length);
                const remainingNew = Math.max(0, settings.newPerDay - stats.introducedToday);
                const fresh = pool.filter(c => !progress[c.id]).slice(0, Math.min(remainingSlots, remainingNew));
                queue = shuffle([...capped, ...fresh]);
            }
            qIndex = 0;
            sessionReviewed = 0;
            lastSnapshot = null;
            window._sessionSeen = new Set();
        }

        function snapshot() { return { progress: JSON.parse(JSON.stringify(progress)), stats: JSON.parse(JSON.stringify(stats)),
                queue: [...queue], qIndex }; }

        async function rate(rating) {
            if (isRating) return;
            isRating = true;
            try {
            const card = queue[qIndex];
            lastSnapshot = snapshot();
            const wasNew = !progress[card.id];
            const st = nextState(card, rating);
            progress[card.id] = st;
            if (wasNew) stats.introducedToday += 1;
            const isFirstReviewToday = stats.reviewedIds.length === 0;
            if (!stats.reviewedIds.includes(card.id)) stats.reviewedIds.push(card.id);
            if (isFirstReviewToday) updateStreak();
            if (!window._sessionSeen.has(card.id)) {
                sessionReviewed += 1;
                window._sessionSeen.add(card.id);
            }
            await saveProgress();
            await saveStats();

            const diffMs = st.due - now();
            if (diffMs <= 20 * MIN) {
                const offset = Math.min(queue.length - qIndex, 3 + Math.round(diffMs / MIN / 2));
                queue.splice(Math.min(queue.length, qIndex + offset), 0, card);
            }
            qIndex += 1;
            flipped = false;
            hasFlippedOnce = false;

            if (qIndex >= queue.length) {
                renderSummary();
            } else {
                renderStudy();
            }
            } finally {
                isRating = false;
            }
        }

        async function undoLast() {
            if (!lastSnapshot) return;
            progress = lastSnapshot.progress;
            stats = lastSnapshot.stats;
            queue = lastSnapshot.queue;
            qIndex = lastSnapshot.qIndex;
            flipped = true;
            hasFlippedOnce = true;
            lastSnapshot = null;
            await saveProgress();
            await saveStats();
            renderStudy();
        }

        function stopTimer() { if (timerInterval) { clearInterval(timerInterval);
                timerInterval = null; } }

        function startTimer() { stopTimer();
            timerVal = settings.timerSeconds || 10;
            timerInterval = setInterval(() => { timerVal -= 1;
                updateTimerUI(); if (timerVal <= 0) stopTimer(); }, 1000); }

        function updateTimerUI() { const el = document.getElementById('timerEl'); if (!el) return;
            el.textContent = timerVal > 0 ? timerVal + 's' : '⏱';
            el.className = 'timer' + (timerVal <= 0 ? ' hot' : ''); }

        function flip() {
            stopCustomAudio();
            flipped = !flipped;
            if (flipped && !hasFlippedOnce) { hasFlippedOnce = true;
                stopTimer(); }
