        /* ========================= V26 CARD CLARITY / IMAGE ZOOM / IPA TEMPLATE ========================= */
        /* Media slot is now only rendered when a photo or emoji exists, so it can stay compact and let the word own the middle of the card. */
        .front-media-slot { min-height: 108px; height: 108px; }
        .front-media-box { width: 100%; height: 100%; }
        .front-media-box .img-slot { width: 100px; height: 100px; }
        .front-word-slot { min-height: 84px; }
        /* NOTE: word font-size is owned exclusively by the JS auto-fit system
           (shrinkToFit/WORD_FONT_MIN/WORD_FONT_MAX below) via inline style. A
           hardcoded !important font-size or a nested max-height/overflow-y
           here would out-rank .auto-fit-text's reset (higher selector
           specificity: .front-word.ar-word beats .auto-fit-text) and silently
           reintroduce the exact clipping/overlap bug this system exists to
           prevent. Do not add font-size/max-height/overflow rules for
           .front-word here again. */

        /* Tap-to-zoom overlay for the front card photo */
        .img-zoom-overlay { position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:10060; display:flex; align-items:center; justify-content:center; padding:22px; animation:modalBackdropIn .18s ease-out both; }
        .img-zoom-full { max-width:92vw; max-height:88vh; width:auto; height:auto; object-fit:contain; border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,.6); animation:modalCardIn .22s cubic-bezier(.22,1,.36,1) both; }

        /* IPA quick-insert flag buttons in the Add/Edit card modals */
        .ipa-input-row { display:flex; gap:7px; align-items:center; }
        .ipa-input-row .add-word-input { flex:1; }
        .ipa-flag-btn { flex:0 0 auto; width:38px; height:38px; border-radius:50%; overflow:hidden; padding:0; border:1px solid var(--line); background:var(--elev2); line-height:0; }
        .ipa-flag-btn svg { display:block; width:100%; height:100%; }
        .ipa-flag-btn:active { transform: scale(.93); }
        .ipa-flag-btn[disabled] { cursor: wait; }
        .ipa-flag-btn.loading svg { animation: ipaFlagPulse .9s ease-in-out infinite; }
        @keyframes ipaFlagPulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

        /* ========================= V27: direction toggle / generate button / live preview ========================= */
        .dir-toggle-btn { margin:0; font-family:'IBM Plex Mono',monospace; font-size:11px; background:rgba(224,167,66,.12); border:1px solid rgba(224,167,66,.35); color:var(--amber); padding:7px 11px; border-radius:999px; font-weight:700; }
        .dir-toggle-btn:active { transform: scale(.95); }

        .btn-generate-audio { display:flex; align-items:center; justify-content:center; gap:6px; width:100%; margin-top:8px; padding:12px; border-radius:12px; border:1px solid rgba(224,167,66,.4); background:var(--amber); color:#1a1200; font-weight:800; font-size:14px; box-shadow:0 4px 0 #a87b1f; }
        .btn-generate-audio:active { transform: translateY(2px); box-shadow:0 2px 0 #a87b1f; }
        .btn-generate-audio[disabled] { opacity:.6; cursor:wait; }

        .mini-preview-wrap { margin: 6px 0 4px; }
        .mini-preview-label { font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--dim); margin-bottom:6px; text-align:center; }
        .mini-preview-card { position:relative; width:100%; max-width:280px; margin:0 auto; height:150px; perspective:1200px; cursor:pointer; }
