        function toggleGenSourcePopover(anchorBtn) {
            if (document.getElementById('genSourcePopover')) { closeGenSourcePopover(); return; }
            openGenSourcePopover(anchorBtn);
        }

        // Any click outside the open popover (including flipping the card or rating
        // it) closes it — this listener runs in the capture phase, before the card's
        // own flip/rate handlers, so it never blocks the action underneath.
        document.addEventListener('click', (e) => {
            const pop = document.getElementById('genSourcePopover');
            if (!pop || pop.contains(e.target)) return;
            if (e.target.closest && e.target.closest('.gen-source-caret')) return;
