                await saveSettings();
                // Update provider tile status
                modal.querySelectorAll('.am-provider').forEach(el => {
                    const pp = el.dataset.provider;
                    const needsKey = providerNeedsKey(pp);
                    const has = needsKey ? !!getProviderKey(pp) : true;
