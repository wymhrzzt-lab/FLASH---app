        .brow-check { width:18px; height:18px; accent-color:var(--amber); }
        .brow-delete { width:30px; height:30px; border-radius:9px; background:rgba(195,86,79,.12); color:var(--again); border:1px solid rgba(195,86,79,.30); font-size:13px; font-weight:800; display:flex; align-items:center; justify-content:center; }
        .custom-delete-note { font-size:10px; color:var(--dim); text-align:center; line-height:1.4; margin-top:-2px; }
        .modal-delete-row { display:flex; gap:8px; margin-top:6px; }
        .modal-delete-row button { flex:1; }
        .modal-edit-row { display:flex; gap:8px; margin-top:6px; }
        .modal-edit-row button { flex:1; }
        .level-extra-wrap { width:100%; display:flex; justify-content:center; margin-top:16px; }
        .level-extra-wrap .level-tile { width:min(210px, 68%); background:linear-gradient(180deg,#1d4f7a,#153a5a); border-color:#2e6fa5; }
        .level-extra-wrap .level-tile .lv { color:var(--amber); }

        /* responsive tweaks */
        @media (max-width: 420px) {
            .am-provider {
                min-width: 60px;
