{n:17, id:'en-a1-017', en:'ago', ar:'منذ', pos:'adv', ipa:'🇺🇲 /əˈɡoʊ/ 🇬🇧 /əˈɡəʊ/', exEn:'He left two hours ago.', exAr:'غادر منذ ساعتين.'},
