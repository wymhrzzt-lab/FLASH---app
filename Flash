            // word-only guard on the fallback below). For the word, any
            // remaining overflow is handled by step 3's frozen slot instead
            // of shrinking further.
            while (guard < 60 && size > min && overflowing()) {
                size = Math.max(min, size - 1);
                el.style.setProperty('font-size', size + 'px', 'important');
                guard++;
            }
            // Absolute last resort, WORD ONLY: pathologically long text (far
            // beyond any real word/expression) that STILL overflows even at
            // the readability floor. Shrinking further is off the table, so
            // freeze the word's own flex slot at the height flexbox already
            // gave it and let IT scroll internally instead of spilling its
            // extra lines onto the buttons/IPA/example around it. IPA/POS/
            // example are deliberately excluded (data-fit-role !== 'word')
            // so they are NEVER frozen and NEVER get their own scrollbar —
            // per the app's fixed policy, any leftover scrolling is always
            // confined to the word, never to the supporting information.
            if (size <= min && overflowing() && scrollBox && el.dataset.fitRole === 'word') {
                // Prefer the tight .word-freeze-boundary wrapper (see
                // buildRichWordHtml/buildCardFaceHtml) so only the word
                // itself gets the private scrollbar — never its POS/IPA
                // siblings, which live outside this wrapper on purpose.
                // Fall back to the old "climb to scrollBox's direct child"
                // behavior only if no such wrapper exists.
                let slot = el.closest('.word-freeze-boundary');
                if (!slot) {
                    slot = el;
