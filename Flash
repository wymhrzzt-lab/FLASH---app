        function refreshAmFetchStatus(modal) {
            const st = normalizeFetchState(loadFetchState());
            saveFetchState(st);
            const btn = modal ? modal.querySelector('#amFetchBtn') : document.getElementById('amFetchBtn');
            const statusDiv = modal ? modal.querySelector('.am-fetch-status') : document.querySelector('.am-fetch-status');
            if (btn) {
                if (st.status === 'running') {
                    btn.innerHTML =
                        `⏳ Running <span class="badge">${st.processedIds.length}/${st.selectedIds.length}</span>`;
                } else if (st.status === 'complete' && st.summary) {
                    btn.innerHTML =
                        `📊 Result <span class="badge">${st.summary.success} done</span>`;
                } else {
                    btn.innerHTML =
                    `▶ Start <span class="badge">${CARDS().length}</span>`;
                }
            }
            if (statusDiv) {
                const dot = statusDiv.querySelector('.dot');
                if (dot) {
                    dot.className = 'dot ' + (st.status === 'running' ? 'running' : st.status === 'complete' ? 'done' :
                        'idle');
                }
                const text = statusDiv.childNodes[2];
                if (text) {
                    if (st.status === 'running') {
                        text.textContent = ` Processing ${st.processedIds.length}/${st.selectedIds.length} words…`;
                    } else if (st.status === 'complete' && st.summary) {
                        text.textContent =
                            ` ${st.summary.success} ready, ${st.summary.failed} failed, ${st.summary.skipped} skipped`;
                    } else {
                        text.textContent = ' Ready — tap Start to fetch missing audio';
                    }
                }
            }
            // Also update the external button if settings page is showing
            const extBtn = document.getElementById('audioManagerBtn');
            if (extBtn) {
                const badge = extBtn.querySelector('.badge');
                if (st.status === 'running') {
                    extBtn.classList.add('active');
                    extBtn.classList.remove('complete');
                    if (badge) badge.textContent = `${st.processedIds.length}/${st.selectedIds.length}`;
                } else if (st.status === 'complete' && st.summary) {
                    extBtn.classList.remove('active');
                    extBtn.classList.add('complete');
                    if (badge) badge.textContent = '✓';
                } else {
                    extBtn.classList.remove('active', 'complete');
                    if (badge) badge.textContent = `${CARDS().length}`;
                }
            }
        }

        function audioAttached(card) { return !!(card && mediaFor(card.id).audio); }

        function fetchMissingCards() { return CARDS().filter(c => !audioAttached(c)); }

        function fetchStatsFromState(st) {
            return {
                total: st.selectedIds.length,
                processed: st.processedIds.length,
                success: st.successIds.length,
                failed: st.failedIds.length,
                skipped: st.skippedIds.length,
                offline: st.successIds.filter(id => mediaFor(id).audioMode === 'offline').length,
                remote: st.successIds.filter(id => mediaFor(id).audioMode === 'remote').length
            };
        }

        function statusWords(st, key) { return (st[key] || []).map(fetchCardById).filter(Boolean); }

        function fetchStatusRows(st) {
            const rows = [
                { key: 'successIds', icon: '✓', title: 'Audio ready', sub: 'Audio attached to the card',
                    color: '#6ac48f', bg: 'rgba(79,157,107,.14)' },
                { key: 'failedIds', icon: '✕', title: 'Could not fetch', sub: 'No usable audio source found',
                    color: '#e57b72', bg: 'rgba(195,86,79,.12)' },
                { key: 'skippedIds', icon: '↷', title: 'Skipped', sub: 'Audio was already present', color: '#e5bf57',
                    bg: 'rgba(224,167,66,.11)' }
            ];
            return rows.map(r => {
                const words = statusWords(st, r.key);
                return `<div class="fetch-status-row" data-fetch-row="${r.key}">
              <div class="fetch-status-head" onclick="this.parentElement.classList.toggle('open')">
                <div class="icon" style="color:${r.color};background:${r.bg};border:1px solid ${r.color}55;">${r.icon}</div>
                <div class="txt"><b>${r.title}</b><span>${r.sub}</span></div>
                <div class="count" style="color:${r.color};">${words.length}</div>
              </div>
              <div class="fetch-status-list">${words.length?words.map((w,i)=>`<div class="fetch-word"><span style="color:${r.color};font-family:'IBM Plex Mono',monospace;font-size:10px;">#${w.n??i+1}</span><span>${escHtml(w.en)}</span></div>`).join(''):'<div class="fetch-note">Nothing here yet.</div>'}</div>
            </div>`;
            }).join('');
        }

        function updateFetchModal(st) {
            st = normalizeFetchState(st);
            saveFetchState(st);
            refreshAmFetchStatus(null);
            const modal = document.getElementById('fetchProgressModal');
            if (!modal) return;
            const total = st.selectedIds.length;
            const processed = st.processedIds.length;
            const pct = total ? Math.round((processed / total) * 100) : 0;
            const current = fetchCardById(st.currentId);
            const t = modal.querySelector('#fetchProgressText');
            if (t) t.textContent = `${processed} / ${total}`;
            const bar = modal.querySelector('#fetchProgressBar');
            if (bar) bar.style.width = pct + '%';
            const pp = modal.querySelector('#fetchProgressPercent');
            if (pp) pp.textContent = pct + '%';
            const cw = modal.querySelector('#fetchCurrentWord');
            if (cw) cw.textContent = current ? current.en : (processed >= total ? 'Complete' : 'Starting…');
            const sg = modal.querySelector('#fetchStatusGroups');
            if (sg) sg.innerHTML = fetchStatusRows(st);
            const done = processed >= total;
            const cancel = modal.querySelector('#fetchCancelBtn');
            if (cancel) cancel.style.display = done ? 'none' : '';
            const hide = modal.querySelector('#fetchHideBtn');
            if (hide) hide.textContent = done ? 'OK' : 'Hide';
            const title = modal.querySelector('#fetchTitle');
            if (title) title.textContent = done ? 'Fetching Audio — Complete' : 'Fetching Audio';
            const note = modal.querySelector('#fetchLiveNote');
            if (note) note.textContent = done ?
                'Final result is saved here and will remain available when you open Audio Manager again.' :
                'The lists above update live while each word is processed.';
        }

        function buildFetchProgressModal(st) {
            let modal = document.getElementById('fetchProgressModal');
            if (modal) modal.remove();
            modal = document.createElement('div');
            modal.id = 'fetchProgressModal';
            modal.className = 'fetch-modal';
            modal.innerHTML = `<div class="fetch-card">
            <h3 class="fetch-title" id="fetchTitle">Fetching Audio</h3>
            <div class="fetch-sub">Live processing for <b>${escHtml(lang)} · ${escHtml(level)}</b></div>
            <div class="fetch-progress-meta"><span>Progress</span><b id="fetchProgressText">0 / 0</b></div>
            <div class="fetch-bar"><div id="fetchProgressBar"></div></div>
            <div class="fetch-current"><div><div class="label">CURRENT WORD</div><div class="word" id="fetchCurrentWord">Starting…</div></div><div id="fetchProgressPercent" style="font-family:'IBM Plex Mono',monospace;color:#78c998;font-size:12px;">0%</div></div>
            <div class="fetch-status" id="fetchStatusGroups"></div>
            <div class="fetch-actions"><button class="fetch-action fetch-cancel" id="fetchCancelBtn">Cancel</button><button class="fetch-action fetch-hide" id="fetchHideBtn">Hide</button></div>
            <div class="fetch-note" id="fetchLiveNote">The lists above update live while each word is processed.</div>
          </div>`;
            document.body.appendChild(modal);
            const cancel = modal.querySelector('#fetchCancelBtn');
            cancel.onclick = () => cancelFetchingAudio();
            modal.querySelector('#fetchHideBtn').onclick = () => {
                if (st.status === 'running') hideFetchingAudio();
                else closeModalAnimated(modal);
            };
            updateFetchModal(st);
            return modal;
        }

        function hideFetchingAudio() {
            const modal = document.getElementById('fetchProgressModal');
            closeModalAnimated(modal, () => {
                refreshAmFetchStatus(null);
                if (screen === 'settings') renderSettings();
            });
        }

        function cancelFetchingAudio() {
            showConfirmModal(
                'Stop Fetching Audio?',
                'Words already processed will keep their audio. Words not reached yet will stay without audio until you run this again.',
                performCancelFetchingAudio,
                'Yes, Stop'
            );
        }

        function performCancelFetchingAudio() {
            if (!fetchRuntime) return;
            fetchRuntime.cancelled = true;
            const st = loadFetchState();
            st.status = 'cancelled';
            st.currentId = null;
            st.finishedAt = Date.now();
            saveFetchState(st);
            fetchRuntime = null;
            audioSystemBusy = false;
            const modal = document.getElementById('fetchProgressModal');
            if (modal) {
                modal.style.animation = 'modalBackdropOut .20s ease-in both';
                const card = modal.firstElementChild;
                if (card) card.style.animation = 'modalCardOut .20s ease-in both';
                setTimeout(() => modal.remove(), 205);
            }
            if (screen === 'settings') renderSettings();
            refreshAmFetchStatus(null);
        }

        async function processSelectedAudio(st) {
            if (fetchRuntime) return;
            if (audioSystemBusy) {
                showInfoModal('⏳', 'Please Wait',
                    'Another audio operation is currently running. Try again once it finishes.', 'var(--hard)');
                return;
            }
            audioSystemBusy = true;
            st = normalizeFetchState(st);
            fetchRuntime = { cancelled: false };
            st.status = 'running';
            saveFetchState(st);
            buildFetchProgressModal(st);
            for (const id of st.selectedIds) {
                if (fetchRuntime.cancelled) break;
                if (st.processedIds.includes(id)) continue;
                const card = fetchCardById(id);
                if (!card) { st.processedIds.push(id); continue; }
                st.currentId = id;
                saveFetchState(st);
                updateFetchModal(st);
                if (audioAttached(card)) {
                    st.skippedIds.push(id);
                    st.processedIds.push(id);
                    st.currentId = null;
                    saveFetchState(st);
                    updateFetchModal(st);
                    continue;
                }
                const got = await fetchRealAudioFor(card.en);
                if (got) {
                    if (!customMedia[id]) customMedia[id] = {};
                    customMedia[id].audio = got.audio;
                    customMedia[id].audioSource = got.audioSource;
                    customMedia[id].audioMode = got.audioMode;
                    customMedia[id].audioTerm = got.term;
                    customMedia[id].audioFetchedAt = Date.now();
                    await saveMedia();
                    st.successIds.push(id);
                } else st.failedIds.push(id);
                st.processedIds.push(id);
                st.currentId = null;
                saveFetchState(st);
                updateFetchModal(st);
                await new Promise(r => setTimeout(r, 40));
            }
            if (!fetchRuntime.cancelled) {
                st.status = 'complete';
                st.currentId = null;
                st.finishedAt = Date.now();
                st.summary = fetchStatsFromState(st);
                saveFetchState(st);
                updateFetchModal(st);
                fetchRuntime = null;
                audioSystemBusy = false;
                setTimeout(() => {
                    const m = document.getElementById('fetchProgressModal');
                    if (m && loadFetchState().status === 'complete') {
                        closeModalAnimated(m, () => {
                            if (screen === 'settings') renderSettings();
                            refreshAmFetchStatus(null);
                        });
                    } else {
                        if (screen === 'settings') renderSettings();
                        refreshAmFetchStatus(null);
                    }
                }, 250);
            } else {
                fetchRuntime = null;
                audioSystemBusy = false;
            }
        }

        function openFetchSummaryModal(st) {
            const sum = st.summary || fetchStatsFromState(st);
            let modal = document.getElementById('fetchProgressModal');
            if (modal) modal.remove();
            modal = document.createElement('div');
            modal.id = 'fetchProgressModal';
            modal.className = 'fetch-modal';
            const failed = statusWords(st, 'failedIds');
            modal.innerHTML = `<div class="fetch-card">
            <h3 class="fetch-title">Fetching Audio — Result</h3>
            <div class="fetch-sub">Saved result for <b>${escHtml(lang)} · ${escHtml(level)}</b></div>
            <div class="fetch-summary-grid">
              <div class="fetch-summary-item"><b style="color:#6ac48f;">${sum.success}</b><span>Audio ready</span></div>
              <div class="fetch-summary-item"><b style="color:#e57b72;">${sum.failed}</b><span>Failed</span></div>
              <div class="fetch-summary-item"><b style="color:#e5bf57;">${sum.skipped}</b><span>Skipped</span></div>
              <div class="fetch-summary-item"><b style="color:#9fd8bc;">${sum.offline}</b><span>Offline saved</span></div>
            </div>
            ${sum.remote?`<div class="fetch-note">${sum.remote} audio item(s) were attached using their working source URL because the host did not allow byte-download from the app. They remain playable online.</div>`:''}
            <div class="fetch-status">${fetchStatusRows(st)}</div>
            <div class="fetch-actions"><button class="fetch-action fetch-ok" id="fetchSummaryOk">OK</button></div>
            ${failed.length?`<div class="fetch-note">Running Fetch again will retry the failed words first — cards that already have audio are skipped instantly, no extra API calls.</div>`:''}
          </div>`;
            document.body.appendChild(modal);
            modal.querySelector('#fetchSummaryOk').onclick = () => {
                closeModalAnimated(modal, () => {
                const latest = loadFetchState();
                latest.status = 'idle';
                latest.summaryViewedAt = Date.now();
                latest.currentId = null;
                saveFetchState(latest);
                if (screen === 'settings') renderSettings();
                refreshAmFetchStatus(null);
                });
            };
        }

        function openFetchSetupModal() {
            const all = CARDS();
            const total = all.length;
            const previous = normalizeFetchState(loadFetchState());
            if (previous.status === 'complete' && previous.summary) { saveFetchState(previous);
                openFetchSummaryModal(previous); return; }
            if (!total) {
                const st = defaultFetchState();
                st.status = 'complete';
                st.selectedIds = [];
                st.summary = { total: 0, processed: 0, success: 0, failed: 0, skipped: 0, offline: 0, remote: 0 };
                saveFetchState(st);
                openFetchSummaryModal(st);
                return;
            }
            let modal = document.getElementById('fetchSetupModal');
            if (modal) modal.remove();
            modal = document.createElement('div');
            modal.id = 'fetchSetupModal';
            modal.className = 'fetch-modal';
            // Put cards that failed on the last run first, so re-running Fetch (even with
            // a smaller count than the full deck) actually retries them before anything else.
            const failedFirst = (previous.failedIds || []).filter(id => all.some(c => c.id === id));
            const rest = all.map(c => c.id).filter(id => !failedFirst.includes(id));
            const pendingIds = [...failedFirst, ...rest];
            modal.innerHTML = `<div class="fetch-card">
            <h3 class="fetch-title">Fetching Audio</h3>
            <div class="fetch-sub">Choose how many cards should be checked now. Cards that already have audio will be placed in <b>Skipped</b>.</div>
            <div class="fetch-setup-row"><input class="fetch-input" id="fetchCountInput" type="number" min="1" max="${total}" value="${total}"><button class="fetch-select-all" id="fetchSelectAll">Select all</button></div>
            <div class="fetch-current"><div><div class="label">CARDS TO CHECK</div><div class="word" id="fetchSelectedLabel">${total} of ${total}</div></div><div style="color:#8ed9b3;font-family:'IBM Plex Mono',monospace;font-size:11px;">${total} total</div></div>
            <div class="fetch-actions"><button class="fetch-action fetch-cancel" id="fetchSetupCancel">Cancel</button><button class="fetch-action fetch-hide" id="fetchSetupStart">Start</button></div>
          </div>`;
            document.body.appendChild(modal);
            const input = modal.querySelector('#fetchCountInput');
            const label = modal.querySelector('#fetchSelectedLabel');
            const clamp = () => { input.value = Math.max(1, Math.min(total, parseInt(input.value) || total));
                label.textContent = input.value + ' of ' + total; };
            input.oninput = () => { label.textContent = (input.value || '0') + ' of ' + total; };
