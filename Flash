                    // space is left" (that measurement kept being wrong in
                    // a new way for every combination of POS/IPA/example/
                    // buttons that could surround the word, each time
                    // causing the word to claim space something else
                    // needed and overlap it). A fixed cap can never
                    // overlap anything below it, because nothing below is
                    // ever asked to give up space for it. The face itself
                    // already scrolls (.front-content/.back-content), so
                    // if the IPA/example/buttons still don't fit under
                    // this, the reader reaches them by scrolling the face
                    // — exactly as before any word ever needed this.
                    const FROZEN_WORD_CAP = 150;
                    slot.style.setProperty('max-height', FROZEN_WORD_CAP + 'px', 'important');
                    slot.style.setProperty('overflow-y', 'auto', 'important');
                    slot.style.setProperty('overflow-x', 'hidden', 'important');
                    setFrozenAlignment(slot, scrollBox, true);
                    // Always start at the very beginning of the text, never
                    // wherever a previous card left the scroll position.
                    slot.scrollTop = 0;
                }
