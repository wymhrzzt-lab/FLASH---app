            document.getElementById('folderActionsCloseBtn').onclick = () => close();
            document.getElementById('folderStudyBtn').onclick = () => close(() => closeAllFolderOverlays(() => studyFolder(folder)));
            document.getElementById('folderBrowseBtn').onclick = () => close(() => closeAllFolderOverlays(() => renderBrowse(folder.id)));
            document.getElementById('folderAddWordBtn').onclick = () => close(() => showAddWordModal(folder.id));
            document.getElementById('folderEditBtn').onclick = () => close(() => showFolderEditModal(folder, refreshList));
            document.getElementById('folderDeleteBtn').onclick = () => close(() => confirmDeleteFolder(folder, refreshList));
        }

        // Builds a study session (normal due+new queue, falling back to a
        // cram of already-started cards) scoped to just one folder's cards.
        function studyFolder(folder) {
            const pool = CARDS().filter(c => c.folderId === folder.id);
            if (pool.length === 0) {
                showInfoModal('📁', 'Folder is empty', `Add some cards to "${escHtml(folder.name)}" first.`, 'var(--hard)');
                return;
            }
            buildQueue(false, folder.id);
            if (queue.length === 0) buildQueue(true, folder.id);
            if (queue.length === 0) {
                showInfoModal('🎉', 'All caught up', `Everything in "${escHtml(folder.name)}" is already reviewed for now — check back later.`, 'var(--good)');
                return;
            }
            renderStudy();
        }

