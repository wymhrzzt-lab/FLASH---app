            const q=id=>document.getElementById(id);
            let newPreviewRefresh = null;

            function wireFields() {
                if (q('picknewImg')) q('picknewImg').onclick=async()=>{const d=await pickDeviceFile('image/*');if(!d)return;draftImg=d;q('newImgStatus').textContent='Image ready';q('newImgPreview').src=d;q('newImgPreview').style.display='block';};
