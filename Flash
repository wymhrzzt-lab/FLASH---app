        async function fetchDictionaryAudioUrl(term) {
            const res = await fetchWithTimeout('https://api.dictionaryapi.dev/api/v2/entries/en/' + encodeURIComponent(term), {},
                15000);
            if (!res.ok) return null;
            const data = await res.json();
            const urls = [];
            for (const entry of Array.isArray(data) ? data : []) {
                for (const p of (entry && Array.isArray(entry.phonetics) ? entry.phonetics : [])) {
                    if (p && p.audio) urls.push({ url: p.audio, text: p.text || '' });
                }
            }
            urls.sort((a, b) => scoreAudioUrl(b.url) - scoreAudioUrl(a.url));
            if (!urls.length) return null;
            return urls[0];
        }

        async function blobToDataUrl(blob) {
            return new Promise(resolve => {
                try {
                    const r = new FileReader();
                    r.onload = () => resolve(r.result);
                    r.onerror = () => resolve(null);
                    r.readAsDataURL(blob);
                } catch (e) { resolve(null); }
            });
        }
        let lastGenerateError = '';
        let audioSystemBusy = false;

        async function fetchRealAudioFor(word) {
            const viaProvider = await fetchProviderAudio(word);
            if (viaProvider) return viaProvider;
            return await fetchDictionaryAudioFallbackFor(word);
        }

        async function fetchProviderAudio(word) {
            const provider = settings.ttsProvider || 'voicerss';
            if (provider === 'voicerss' && settings.voiceRssKey) return await fetchVoiceRssAudio(word);
            if (provider === 'elevenlabs' && settings.elevenLabsKey) return await fetchElevenLabsAudio(word);
            if (provider === 'voiceai' && settings.voiceAiKey) return await fetchVoiceAiAudio(word);
            if (provider === 'puter') return await fetchPuterAudio(word);
            return null;
        }

        async function fetchDictionaryAudioFallbackFor(word) {
            const candidates = cleanAudioCandidates(word);
            for (const term of candidates) {
                try {
                    const found = await fetchDictionaryAudioUrl(term);
                    if (!found || !found.url) continue;
                    let audioUrl = found.url;
                    if (audioUrl.startsWith('//')) audioUrl = 'https:' + audioUrl;

                    try {
                        const audioRes = await fetchWithTimeout(audioUrl, { mode: 'cors' }, 15000);
                        if (audioRes.ok) {
                            const blob = await audioRes.blob();
                            if (blob && blob.size > 100) {
                                const dataUrl = await blobToDataUrl(blob);
                                if (dataUrl) return { audio: dataUrl, audioSource: audioUrl, audioMode: 'offline',
                                    mime: blob.type || 'audio/mpeg', term };
                            }
                        }
                    } catch (e) {}

                    return { audio: audioUrl, audioSource: audioUrl, audioMode: 'remote', mime: 'audio/mpeg', term };
                } catch (e) { /* try next candidate */ }
            }
            return null;
        }

        async function fetchVoiceRssAudio(word) {
            const key = settings.voiceRssKey;
            if (!key) return null;

            const targetUrl =
                `https://api.voicerss.org/?key=${encodeURIComponent(key)}&hl=en-us&src=${encodeURIComponent(word)}&c=MP3&f=48khz_16bit_stereo`;

            async function parseVoiceRssResponse(res, label) {
                if (!res.ok) {
                    let reason = 'VoiceRSS: request failed (HTTP ' + res.status + ')';
                    try {
                        const contentType = res.headers.get('content-type') || '';
                        if (contentType.includes('text') || contentType.includes('json')) {
                            const txt = (await res.text()).trim();
                            if (txt) reason = 'VoiceRSS: ' + txt.slice(0, 180);
                        }
                    } catch (e) {}
                    lastGenerateError = reason;
                    return null;
                }

                const blob = await res.blob();
                if (!blob || blob.size < 200) {
                    lastGenerateError = 'VoiceRSS: empty response' + (label ? ' (' + label + ')' : '');
                    return null;
                }

                const bytes = new Uint8Array(await blob.arrayBuffer());
                const type = String(blob.type || '').toLowerCase().split(';')[0].trim();
                const isMp3 = bytes.length >= 3 && bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33;
                const isMp3Frame = bytes.length >= 2 && bytes[0] === 0xFF && (bytes[1] & 0xE0) === 0xE0;
                const isWav = bytes.length >= 12 && bytes[0] === 0x52 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x46 &&
                    bytes[8] === 0x57 && bytes[9] === 0x41 && bytes[10] === 0x56 && bytes[11] === 0x45;
                const looksAudio = type.startsWith('audio/') || type === 'application/octet-stream' && (isMp3 || isMp3Frame || isWav);
                if (!looksAudio) {
                    let detail = '';
                    try {
                        const txt = new TextDecoder().decode(bytes.slice(0, 180)).trim();
                        if (txt) detail = ' — ' + txt.replace(/\s+/g, ' ').slice(0, 120);
                    } catch (e) {}
                    lastGenerateError = 'VoiceRSS: returned a non-audio response' + detail;
                    return null;
                }

                const dataUrl = await blobToDataUrl(new Blob([bytes], { type: type || 'audio/mpeg' }));
                if (!dataUrl) {
                    lastGenerateError = 'VoiceRSS: could not convert the returned audio';
                    return null;
                }
                return {
                    audio: dataUrl,
                    audioSource: 'voicerss',
                    audioMode: 'offline',
                    mime: type || 'audio/mpeg',
                    term: word
                };
            }

            // Direct request works in normal browsers that permit VoiceRSS CORS.
            try {
                const direct = await fetchWithTimeout(targetUrl, { mode: 'cors' }, 15000);
                const directResult = await parseVoiceRssResponse(direct, 'direct');
                if (directResult) return directResult;
            } catch (e) {
                // WebViews/file:// often block the direct cross-origin request.
            }

            // Browser/WebView-safe fallback. CORS.SH streams the upstream response byte-for-byte.
            try {
                const proxyUrl = 'https://proxy.cors.sh/' + targetUrl;
                const proxied = await fetchWithTimeout(proxyUrl, {
                    method: 'GET',
                    headers: { 'Accept': 'audio/mpeg, application/octet-stream;q=0.9, */*;q=0.8' }
                }, 30000);
                const proxyResult = await parseVoiceRssResponse(proxied, 'CORS proxy');
                if (proxyResult) return proxyResult;
            } catch (e) {
                const msg = String(e && e.message ? e.message : e || '').toLowerCase();
                if (msg.includes('abort') || msg.includes('timeout')) {
                    lastGenerateError = 'VoiceRSS: request timed out';
                } else {
                    lastGenerateError = 'VoiceRSS: network request failed — could not reach the API or CORS proxy';
                }
            }
            return null;
        }

        // FIXED: ElevenLabs uses a non-library premade voice (Adam) that works with free tier.
        async function fetchElevenLabsAudio(word) {
            const key = settings.elevenLabsKey;
            if (!key) return null;
            try {
                // Use "Adam" (pNInz6obpgDQGcFmaJgB) — a standard premade voice, NOT a library voice.
                // Free tier users can use premade voices via API.
                const voiceId = 'pNInz6obpgDQGcFmaJgB';
                const res = await fetchWithTimeout(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {
                    method: 'POST',
                    headers: { 'xi-api-key': key, 'Content-Type': 'application/json', 'Accept': 'audio/mpeg' },
                    body: JSON.stringify({
                        text: word,
                        model_id: 'eleven_multilingual_v2',
                        voice_settings: { stability: 0.5, similarity_boost: 0.85, style: 0, use_speaker_boost: true }
                    })
                }, 20000);
                if (!res.ok) {
                    let reason = 'ElevenLabs: request failed (HTTP ' + res.status + ')';
                    try {
                        const errJson = await res.json();
                        if (errJson && errJson.detail) {
                            const msg = errJson.detail.message || errJson.detail;
                            reason = 'ElevenLabs: ' + String(msg).slice(0, 120);
                        }
                    } catch (e) {}
                    lastGenerateError = reason;
                    return null;
                }
                const blob = await res.blob();
                if (!blob || blob.size < 200) { lastGenerateError = 'ElevenLabs: empty audio returned'; return null; }
                const dataUrl = await blobToDataUrl(blob);
                if (!dataUrl) return null;
                return { audio: dataUrl, audioSource: 'elevenlabs', audioMode: 'offline', mime: blob.type || 'audio/mpeg',
                    term: word };
            } catch (e) { lastGenerateError = 'ElevenLabs: network request failed — could not reach the API'; return null; }
        }

        // Voice.AI TTS provider.
        // Voice.ai REST TTS is CORS-blocked in browsers, so a browser-safe proxy is used
        // when direct access cannot be completed (including file:// / WebView origins).
        async function fetchVoiceAiAudio(word) {
            const key = settings.voiceAiKey;
            if (!key) return null;

            const targetUrl = 'https://dev.voice.ai/api/v1/tts/speech';
            const requestOptions = {
                method: 'POST',
                credentials: 'omit',
                headers: {
                    'Authorization': 'Bearer ' + key,
                    'Content-Type': 'application/json',
                    'Accept': 'audio/mpeg'
                },
                body: JSON.stringify({
                    text: word,
                    model: 'voiceai-tts-v1-latest',
                    language: 'en'
                })
            };

            function looksLikeAudio(blob, bytes) {
                const type = String(blob && blob.type || '').toLowerCase().split(';')[0].trim();
                if (type.startsWith('audio/')) return true;
                if (type === 'application/octet-stream') {
                    if (bytes.length >= 4 &&
                        bytes[0] === 0x52 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x46) return true;
                    if (bytes.length >= 3 &&
                        bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) return true;
                    if (bytes.length >= 2 &&
                        bytes[0] === 0xFF && (bytes[1] & 0xE0) === 0xE0) return true;
                }
                return false;
            }

            async function handleResponse(res, label) {
                if (!res.ok) {
                    let reason = 'Voice.AI: request failed (HTTP ' + res.status + ')';
                    try {
                        const contentType = res.headers.get('content-type') || '';
                        if (contentType.includes('application/json')) {
                            const errJson = await res.json();
                            const msg = errJson && (errJson.message || errJson.error || errJson.detail || errJson.body);
                            if (msg) reason = 'Voice.AI: ' + String(msg).slice(0, 160);
                        } else {
                            const txt = (await res.text()).trim();
                            if (txt) reason = 'Voice.AI: ' + txt.slice(0, 160);
                        }
                    } catch (e) {}
                    lastGenerateError = reason;
                    return null;
                }

                const blob = await res.blob();
                if (!blob || blob.size < 200) {
                    lastGenerateError = 'Voice.AI: empty audio returned' + (label ? ' (' + label + ')' : '');
                    return null;
                }

                const bytes = new Uint8Array(await blob.arrayBuffer());
                if (!looksLikeAudio(blob, bytes)) {
                    let detail = '';
                    try {
                        const preview = new TextDecoder().decode(bytes.slice(0, 180)).trim();
                        if (preview) detail = ' — ' + preview.replace(/\s+/g, ' ').slice(0, 120);
                    } catch (e) {}
                    lastGenerateError = 'Voice.AI: proxy returned a non-audio response' + detail;
                    return null;
                }

                const dataUrl = await blobToDataUrl(blob);
                if (!dataUrl) {
                    lastGenerateError = 'Voice.AI: could not convert the returned audio';
                    return null;
                }
                return {
                    audio: dataUrl,
                    audioSource: 'voiceai',
                    audioMode: 'offline',
                    mime: blob.type || 'audio/mpeg',
                    term: word
                };
            }

            // Use CORS.SH raw-response routing instead of cors.io's JSON wrapper.
            // Voice.ai returns the generated audio as response bytes.
            const proxyUrl = 'https://cors.sh/' + targetUrl;

            try {
                const proxiedRes = await fetchWithTimeout(proxyUrl, requestOptions, 30000);
                const proxiedResult = await handleResponse(proxiedRes, 'CORS.SH');
                if (proxiedResult) return proxiedResult;
                return null;
            } catch (e) {
                const msg = String(e && e.message ? e.message : e || '').toLowerCase();
                if (msg.includes('abort') || msg.includes('timeout')) {
                    lastGenerateError = 'Voice.AI: request timed out while using the CORS proxy';
                } else {
                    lastGenerateError = 'Voice.AI: browser could not complete the proxied API request.';
                }
                return null;
            }
        }

        // Puter.ai TTS provider — free & unlimited, no API key required.
        // Docs: https://developer.puter.com/tutorials/free-unlimited-text-to-speech-api/
        // puter.ai.txt2speech() resolves to a playable <audio>-like element pointing at a
        // blob/remote URL. We fetch that URL ourselves and convert it to a data: URL so the
        // result is stored and played back exactly like the other providers (fully offline
        // afterwards, works the same in the browser, in Acode/QuickEdit previews, and in the app).
        // The <script src="js.puter.com/v2/" defer> tag can still be loading the
        // first time the user taps Generate right after opening the app. Rather
        // than fail immediately, poll briefly for `puter.ai` to become ready.
        async function waitForPuter(maxWaitMs = 6000) {
            const stepMs = 150;
            let waited = 0;
            while (typeof puter === 'undefined' || !puter.ai || typeof puter.ai.txt2speech !== 'function') {
                if (waited >= maxWaitMs) return false;
                await new Promise(r => setTimeout(r, stepMs));
                waited += stepMs;
            }
            return true;
        }

        async function fetchPuterAudio(word) {
            const ready = await waitForPuter();
            if (!ready) {
                lastGenerateError = 'Puter.ai: library not loaded yet — check your internet connection and try again';
                return null;
            }
            try {
                const audioEl = await puter.ai.txt2speech(word, {
                    voice: 'Joanna',
                    engine: 'neural',
                    language: 'en-US'
                });
                const src = audioEl && (audioEl.src || (audioEl.currentSrc));
                if (!src) {
                    lastGenerateError = 'Puter.ai: no audio was returned';
                    return null;
                }
                const res = await fetchWithTimeout(src, {}, 20000);
                if (!res.ok) {
                    lastGenerateError = 'Puter.ai: request failed (HTTP ' + res.status + ')';
                    return null;
                }
                const blob = await res.blob();
                if (!blob || blob.size < 200) {
                    lastGenerateError = 'Puter.ai: empty audio returned';
                    return null;
                }
                const dataUrl = await blobToDataUrl(blob);
                if (!dataUrl) {
                    lastGenerateError = 'Puter.ai: could not convert the returned audio';
                    return null;
                }
                return { audio: dataUrl, audioSource: 'puter', audioMode: 'offline', mime: blob.type || 'audio/mpeg',
                    term: word };
            } catch (e) {
                const msg = String(e && e.message ? e.message : e || '');
                lastGenerateError = 'Puter.ai: ' + (msg || 'request failed — check your internet connection');
                return null;
            }
        }

        // Providers that don't need an API key at all (currently just Puter.ai).
        function providerNeedsKey(p) { return p !== 'puter'; }

        function audioAnyKeySet() {
            return !!(settings.voiceRssKey || settings.elevenLabsKey || settings.voiceAiKey || settings.ttsProvider === 'puter');
        }

        function getProviderDisplayName(p) {
            if (p === 'voicerss') return 'VoiceRSS';
            if (p === 'elevenlabs') return 'ElevenLabs';
            if (p === 'voiceai') return 'Voice.AI';
            if (p === 'puter') return 'Puter.ai (Free)';
            return p;
        }

        function getProviderKey(p) {
            if (p === 'voicerss') return settings.voiceRssKey || '';
            if (p === 'elevenlabs') return settings.elevenLabsKey || '';
            if (p === 'voiceai') return settings.voiceAiKey || '';
            return '';
        }

        function setProviderKey(p, val) {
            if (p === 'voicerss') settings.voiceRssKey = val;
            else if (p === 'elevenlabs') settings.elevenLabsKey = val;
            else if (p === 'voiceai') settings.voiceAiKey = val;
        }

        // ============================================================
        // AUDIO MANAGER MODAL — unified entry point
        // ============================================================
        let _amModalOpen = false;

        function showAudioManagerModal() {
            if (_amModalOpen) return;
            _amModalOpen = true;
            const currentProvider = settings.ttsProvider || 'voicerss';
            const st = normalizeFetchState(loadFetchState());
            saveFetchState(st);

            const modal = document.createElement('div');
            modal.className = 'am-modal';
            modal.id = 'amModal';
            modal.innerHTML = `
            <div class="am-card">
