<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Vocabulary Flashcards V17</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Cairo:wght@600;800&family=Fraunces:ital,wght@0,600;0,700;1,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0b0e12;
            --elev1: #12161c;
            --elev2: #181d25;
            --line: #262b33;
            --text: #e8e6df;
            --dim: #8b8f97;
            --amber: #e0a742;
            --teal: #4fb3a9;
            --again: #c3564f;
            --hard: #cf8a42;
            --good: #4f9d6b;
            --easy: #4fb3a9;
            --blue: #4f8fe0;
        }
        * {
            box-sizing: border-box;
        }
        html,
        body {
            overscroll-behavior: none;
        }
        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at 15% -10%, #1a2029 0%, transparent 50%), var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            padding: 22px 14px 50px;
        }
        .app {
            width: 100%;
            max-width: 440px;
        }
        .rtl {
            direction: rtl;
            font-family: 'Cairo', sans-serif;
            text-align: right;
        }
        .eyebrow {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            letter-spacing: .1em;
            color: var(--amber);
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        h1 {
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 24px;
            margin: 0 0 4px;
        }
        .sub {
            color: var(--dim);
            font-size: 13px;
            margin-bottom: 18px;
        }
        button {
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            border: none;
            -webkit-tap-highlight-color: transparent;
        }
        * {
            -webkit-tap-highlight-color: transparent !important;
        }

        .topbar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }
        .back-arrow {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--elev1);
            border: 1px solid var(--line);
            color: var(--text);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .undo-btn {
            margin-inline-start: auto;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            background: var(--elev1);
            border: 1px solid var(--line);
            color: var(--dim);
            padding: 7px 11px;
            border-radius: 999px;
        }
        .undo-btn:disabled {
            opacity: .3;
        }

        .choice-card {
            width: 100%;
            text-align: left;
            background: var(--elev1);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .choice-card .name {
            font-family: 'Fraunces', serif;
            font-size: 19px;
            font-weight: 700;
            color: var(--amber);
        }
        .choice-card .meta {
            font-size: 12px;
            color: var(--dim);
            margin-top: 2px;
        }
        .choice-card .tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 10px;
            background: rgba(224, 167, 66, .15);
            color: var(--amber);
            border: 1px solid rgba(224, 167, 66, .3);
            padding: 3px 8px;
            border-radius: 999px;
        }
        .choice-card:disabled {
            opacity: .5;
        }

        .level-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }
        .level-tile {
            background: var(--elev1);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 16px 10px;
            text-align: center;
        }
        .level-tile .lv {
            font-family: 'Fraunces', serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--amber);
        }
        .level-tile .ct {
            font-size: 11px;
            color: var(--dim);
            margin-top: 3px;
            font-family: 'IBM Plex Mono', monospace;
        }
        .level-tile:disabled {
            opacity: .4;
        }

        .stats {
            display: flex;
            gap: 9px;
            margin-bottom: 18px;
        }
        .stat {
            flex: 1;
            background: var(--elev1);
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 11px 6px;
            text-align: center;
        }
        .stat b {
            display: block;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 19px;
            color: var(--amber);
        }
        .stat span {
            font-size: 10px;
            color: var(--dim);
        }

        .btn-main {
            width: 100%;
            background: var(--teal);
            color: #06201c;
            font-weight: 800;
            font-size: 15px;
            padding: 15px;
            border-radius: 13px;
            margin-bottom: 9px;
            box-shadow: 0 4px 0 #2e756c;
        }
        .btn-main:disabled {
            opacity: .4;
            box-shadow: none;
        }
        .btn-main:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #2e756c;
        }
        .btn-ghost {
            width: 100%;
            background: var(--elev1);
            color: var(--text);
            border: 1px solid var(--line);
            font-size: 14px;
            padding: 12px;
            border-radius: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .btn-ghost:disabled {
            opacity: .4;
        }

        .stage {
            position: relative;
            height: 380px;
            margin: 10px 0 16px;
        }
        .deck-shadow {
            position: absolute;
            inset: 0;
            border-radius: 18px;
            background: var(--elev2);
            border: 1px solid var(--line);
        }
        .deck-shadow.s1 {
            transform: translateY(9px) scale(.97);
            opacity: .6;
        }
        .deck-shadow.s2 {
            transform: translateY(16px) scale(.94);
            opacity: .3;
        }
        .card-outer {
            position: absolute;
            inset: 0;
            perspective: 1500px;
            -webkit-perspective: 1500px;
        }
        .card {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            -webkit-transform-style: preserve-3d;
            transition: transform .6s cubic-bezier(.2, .8, .2, 1);
            will-change: transform;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }
        /* Allow copying example sentences even though the rest of the card is non-selectable */
        .example .en-ex,
        .example .ar-ex {
            user-select: text;
            -webkit-user-select: text;
        }
        .card.flipped {
            transform: rotateX(180deg);
            -webkit-transform: rotateX(180deg);
        }
        .face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 18px;
            border: 1px solid var(--line);
            background: var(--elev1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 22px;
            box-shadow: 0 18px 34px rgba(0, 0, 0, .5);
        }
        .face.back {
            transform: rotateX(180deg);
            -webkit-transform: rotateX(180deg);
            justify-content: flex-start;
            padding-top: 26px;
            align-items: flex-start;
        }
        /* backface-visibility:hidden only hides the non-showing face visually —
           on some mobile browsers its buttons (e.g. the back's speak button)
           can still receive taps even though invisible. Block interaction
           with whichever face isn't currently facing the user. */
        .card:not(.flipped) .face.back { pointer-events: none; }
        .card.flipped .face.front { pointer-events: none; }
        .timer {
            position: absolute;
            top: 14px;
            right: 14px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 12px;
            color: var(--dim);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 3px 9px;
        }
        .timer.hot {
            color: #fff;
            background: var(--again);
            border-color: var(--again);
            animation: flash 1s infinite;
        }
        @keyframes flash {
            50% {
                opacity: .45;
            }
        }
        .emo {
            font-size: 62px;
            line-height: 1;
            margin-bottom: 12px;
            align-self: center;
        }
        .img-slot {
            width: 140px;
            height: 140px;
            border-radius: 16px;
            margin-bottom: 14px;
            border: 2px dashed rgba(224, 167, 66, .3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--dim);
            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            font-weight: 600;
            background: rgba(224, 167, 66, .04);
            flex-shrink: 0;
        }
        .img-slot .plus {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(224, 167, 66, .15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--amber);
            line-height: 1;
        }
        .custom-img-wrap {
            position: relative;
            margin-bottom: 14px;
            flex-shrink: 0;
        }
        .custom-img {
            width: 140px;
            height: 140px;
            object-fit: cover;
            border-radius: 16px;
            border: 1px solid var(--line);
            display: block;
        }
        .img-remove-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--again);
            color: #fff;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--bg);
            box-shadow: 0 2px 6px rgba(0,0,0,.4);
            z-index: 2;
        }
        .swap-img-link,
        .audio-link {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            color: var(--teal);
            background: rgba(79, 179, 169, .12);
            border: 1px solid rgba(79, 179, 169, .35);
            border-radius: 999px;
            padding: 6px 14px;
            margin-top: 8px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .audio-link.remove {
            color: var(--again);
            background: rgba(195, 86, 79, .12);
            border-color: rgba(195, 86, 79, .35);
        }
        .audio-link.photo-link {
            color: var(--blue);
            background: rgba(79, 143, 224, .12);
            border-color: rgba(79, 143, 224, .35);
        }
        .ar-word {
            font-size: 29px;
            font-weight: 800;
            align-self: center;
        }
        .ar-word.solo {
            font-size: 34px;
        }
        .hint {
            position: absolute;
            bottom: 16px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 11px;
            color: var(--dim);
            font-family: 'IBM Plex Mono', monospace;
        }

        .pos-ipa {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pos-pill {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 12px;
            color: var(--teal);
            background: rgba(79, 179, 169, .12);
            border: 1px solid rgba(79, 179, 169, .3);
            padding: 3px 8px;
            border-radius: 7px;
        }
        .ipa {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 14px;
            color: var(--dim);
        }
        .speak-btn {
            position: relative;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--teal);
            border: none;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 3px 4px 0 rgba(0, 0, 0, .25);
            transition: transform .15s ease;
        }
        .speak-btn::after {
            content: '';
            width: 0;
            height: 0;
            border-top: 9px solid transparent;
            border-bottom: 9px solid transparent;
            border-left: 15px solid #fff;
            margin-left: 4px;
        }
        .speak-btn:active {
            transform: scale(0.93);
        }
        .en-word {
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 33px;
            color: var(--amber);
        }
        .ar-back {
            font-size: 19px;
            color: var(--text);
            margin-top: 2px;
            width: 100%;
        }
        /* When the direction toggle puts Arabic into a slot normally styled for
           English (.en-word for the back identity, .ar-back for the secondary
           reminder line), force the Arabic font back on regardless of rule order. */
        .en-word.rtl, .ar-back.rtl { font-family: 'Cairo', sans-serif; }
        .example {
            width: 100%;
            margin-top: 16px;
            background: var(--elev2);
            border-inline-start: 3px solid var(--teal);
            border-radius: 8px;
            padding: 11px 13px;
        }
        .example .en-ex {
            font-size: 13.5px;
            color: var(--text);
            line-height: 1.4;
        }
        .example .ar-ex {
            font-size: 12.5px;
            color: var(--dim);
            margin-top: 5px;
            line-height: 1.5;
        }

        .rate-row {
            display: flex;
            gap: 7px;
        }
        .rate-btn {
            flex: 1;
            padding: 11px 3px;
            border-radius: 11px;
            color: #fff;
            font-size: 12.5px;
            font-weight: 700;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
        }
        .rate-btn small {
            font-family: 'IBM Plex Mono', monospace;
            font-weight: 400;
            font-size: 9.5px;
            opacity: .9;
        }
        .again {
            background: var(--again);
        }
        .hard {
            background: var(--hard);
        }
        .good {
            background: var(--good);
        }
        .easy {
            background: var(--easy);
            color: #06201c;
        }

        .progress-line {
            height: 4px;
            background: var(--elev1);
            border-radius: 2px;
            margin-bottom: 14px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: var(--amber);
            width: 0%;
            transition: width .3s;
        }

        .settings-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            color: var(--dim);
            margin-top: 16px;
            border-top: 1px solid var(--line);
            padding-top: 14px;
        }
        .settings-row input {
            width: 64px;
            text-align: center;
            background: var(--elev1);
            color: var(--text);
            border: 1px solid var(--line);
            border-radius: 7px;
            padding: 5px;
            font-family: 'IBM Plex Mono', monospace;
        }
        .settings-row input[type="checkbox"] {
            width: 20px;
            height: 20px;
            padding: 0;
            accent-color: var(--amber);
        }

        /* --- iOS-style ON/OFF toggle switch with green/red glow --- */
        .io-switch {
            position: relative;
            display: inline-block;
            width: 62px;
            height: 30px;
            flex-shrink: 0;
            cursor: pointer;
        }
        .io-switch input[type="checkbox"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            opacity: 0;
            cursor: pointer;
            z-index: 2;
        }
        .io-track {
            position: absolute;
            inset: 0;
            border-radius: 999px;
            background: linear-gradient(180deg, #d1453d, #9c2d27);
            box-shadow:
                inset 0 0 0 1px rgba(0, 0, 0, .35),
                inset 0 1px 2px rgba(255, 255, 255, .15),
                0 0 7px 1px rgba(214, 70, 60, .45);
            transition: background .45s ease, box-shadow .45s ease;
            overflow: hidden;
        }
        .io-switch input:checked~.io-track {
            background: linear-gradient(180deg, #4caf50, #2e7d32);
            box-shadow:
                inset 0 0 0 1px rgba(0, 0, 0, .35),
                inset 0 1px 2px rgba(255, 255, 255, .15),
                0 0 8px 2px rgba(76, 200, 90, .55);
        }
        .io-knob {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .45);
            transition: left .35s cubic-bezier(.4, 0, .2, 1);
        }
        .io-switch input:checked~.io-track .io-knob {
            left: 35px;
        }
        .io-text {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .04em;
            color: #fff;
            transition: opacity .3s ease;
        }
        .io-text-on {
            left: 7px;
            opacity: 0;
        }
        .io-text-off {
            right: 6px;
            opacity: 1;
        }
        .io-switch input:checked~.io-track .io-text-on {
            opacity: 1;
        }
        .io-switch input:checked~.io-track .io-text-off {
            opacity: 0;
        }
        .reset-link {
            background: none;
            color: var(--again);
            font-size: 13px;
            font-weight: 600;
            text-decoration: underline;
            margin-top: 20px;
            cursor: pointer;
            border: none;
            padding: 10px;
        }

        .browse-list {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-top: 6px;
        }
        .brow {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--elev1);
            border: 1px solid var(--line);
            border-radius: 11px;
            padding: 11px 12px;
            cursor: pointer;
            transition: background .2s;
        }
        .brow:active {
            background: var(--elev2);
        }
        .brow .n {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            color: var(--dim);
            width: 24px;
        }
        .brow .e {
            font-size: 20px;
            width: 26px;
            text-align: center;
        }
        .brow .ar {
            font-size: 14px;
            font-weight: 800;
            flex: 1;
        }
        .brow .en {
            font-size: 12.5px;
            color: var(--dim);
        }
        .search {
            width: 100%;
            padding: 11px 14px;
            border-radius: 11px;
            margin-bottom: 12px;
            background: var(--elev1);
            border: 1px solid var(--line);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }
        .search::placeholder {
            color: var(--dim);
        }
        .empty-note {
            text-align: center;
            color: var(--dim);
            font-size: 13px;
            padding: 30px 10px;
        }

        .streak-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 12px;
            color: var(--amber);
            background: rgba(224, 167, 66, .12);
            border: 1px solid rgba(224, 167, 66, .3);
            padding: 5px 12px;
            border-radius: 999px;
            margin-bottom: 14px;
        }

        .caught-up-block {
            text-align: center;
            padding: 20px 10px 6px;
        }
        .caught-up-emo {
            font-size: 52px;
            line-height: 1;
            animation: celebrate .6s cubic-bezier(.22,1,.36,1) both;
        }
        .caught-up-title {
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 19px;
            color: var(--amber);
            margin-top: 8px;
        }
        .caught-up-sub {
            font-size: 12.5px;
            color: var(--dim);
            margin-top: 4px;
        }
        @keyframes celebrate {
            0% { transform: scale(.7) rotate(-10deg); opacity: 0; }
            60% { transform: scale(1.15) rotate(6deg); opacity: 1; }
            100% { transform: scale(1) rotate(0); }
        }

        .summary {
            text-align: center;
            padding: 26px 6px;
        }
        .summary .emo {
            font-size: 50px;
        }
        .summary-stats {
            display: flex;
            gap: 9px;
            margin: 18px 0;
        }
        .rest-note {
            text-align: center;
            font-size: 11.5px;
            color: var(--dim);
            margin-top: 8px;
            font-family: 'IBM Plex Mono', monospace;
        }
        .loading {
            text-align: center;
            padding: 60px 0;
            color: var(--dim);
            font-family: 'IBM Plex Mono', monospace;
            font-size: 13px;
        }

        #rateArea {
            opacity: 0;
            transform: translateY(20px) scale(0.92);
            transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0s 0.35s;
            pointer-events: none;
            visibility: hidden;
            display: block !important;
        }
        #rateArea.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
            visibility: visible;
            transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0s 0s;
        }

        /* ========================= FETCH / AUDIO MANAGER UI ========================= */
        .audio-manager-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px 9px 14px;
            border-radius: 999px;
            border: 1px solid #2f765e;
            color: #d8f4e7;
            background: linear-gradient(180deg, #173d31, #113228);
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 800;
            box-shadow: 0 4px 0 #0a2119;
            transition: .18s ease;
            cursor: pointer;
            width: auto;
            min-width: 0;
            margin: 6px 0;
        }
        .audio-manager-btn:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #0a2119;
        }
        .audio-manager-btn .sym {
