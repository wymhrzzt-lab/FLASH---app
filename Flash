                if (q('newIpaUK')) q('newIpaUK').onclick=async()=>{await autoFillIPA(q('newIpa'), q('newEn'), 'uk', q('newIpaUK')); if(newPreviewRefresh) newPreviewRefresh();};
                if (q('newGenerateAudioBtn')) q('newGenerateAudioBtn').onclick=()=>generateAudioForDraft(q('newEn'), q('newAudioStatus'), (dataUrl)=>{draftAudio=dataUrl;}, q('newGenerateAudioBtn'));
                if (q('newGenSourceToggle')) initGenSourceDropdown(q('newGenSourceToggle'), q('newGenSourceDropdown'));
                if (q('newPos')) initPosDropdown(q('newPos'), q('newPosToggle'), q('newPosDropdown'));
