        function closeGenSourcePopover() {
            const el = document.getElementById('genSourcePopover');
            if (el) el.remove();
        }

        function openGenSourcePopover(anchorBtn) {
            closeGenSourcePopover();
            const pop = document.createElement('div');
            pop.className = 'gen-source-popover';
            pop.id = 'genSourcePopover';
            const current = settings.ttsProvider || 'voicerss';
            const chip = p => {
                const needsKey = providerNeedsKey(p);
                const has = needsKey ? !!getProviderKey(p) : true;
                const lock = needsKey ? (has ? '🔑' : '🚫 no key') : '✅ free';
                return `<button type="button" class="gen-source-chip${p === current ? ' selected' : ''}" data-provider="${p}">
                    <span>${shortProviderLabel(p)}</span><span class="lock">${lock}</span>
                </button>`;
            };
            pop.innerHTML = GEN_SOURCE_PROVIDERS.map(chip).join('');
            document.body.appendChild(pop);
            pop.querySelectorAll('.gen-source-chip').forEach(btn => {
                btn.onclick = (e) => {
                    e.stopPropagation();
                    const p = btn.dataset.provider;
                    if (providerNeedsKey(p) && !getProviderKey(p)) {
                        closeGenSourcePopover();
                        showInfoModal('🔑', 'No API key set',
                            getProviderDisplayName(p) + ' needs an API key first. Open Audio Manager (⚙️ Settings) once to add it, or pick Puter.ai which needs no key.',
                            'var(--hard)');
                        return;
                    }
                    settings.ttsProvider = p;
                    saveSettings();
                    closeGenSourcePopover();
                };
            });
            // Position next to the caret, clamped inside the viewport (small mobile screens).
            const r = anchorBtn.getBoundingClientRect();
            pop.style.visibility = 'hidden';
            requestAnimationFrame(() => {
                const vw = window.innerWidth, vh = window.innerHeight;
                const pw = pop.offsetWidth, ph = pop.offsetHeight;
                let left = Math.min(Math.max(8, r.left), vw - pw - 8);
                let top = r.bottom + 6;
                if (top + ph > vh - 8) top = Math.max(8, r.top - ph - 6);
                pop.style.left = left + 'px';
                pop.style.top = top + 'px';
                pop.style.visibility = 'visible';
            });
