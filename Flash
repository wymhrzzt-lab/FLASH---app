            const v = { ar: card.ar||'', en: card.en||'', pos: card.pos||'', ipa: card.ipa||'', exEn: card.exEn||'', exAr: card.exAr||'', frontPos: card.frontPos||'', frontIpa: card.frontIpa||'', frontExEn: card.frontExEn||'', frontExAr: card.frontExAr||'' };
            const showFolderPicker = isCustomCard(card) && isExtraCard;
            const modal = document.createElement('div');
            modal.className='add-word-modal'; modal.id='editCardModal';
            function mediaTextNow() {
                return { audio: draftAudio ? 'Audio selected' : 'No audio selected', audioFront: draftAudioFront ? 'Audio selected' : 'No audio selected', img: draftImg ? 'Image selected' : 'No image selected', imgSrc: draftImg || '' };
            }
            modal.innerHTML=`
              <div class="add-word-card">
                <h3 class="add-word-title">✏️ Edit Card</h3>
                <div class="add-word-sub">Edit any field. Empty optional fields are allowed. The original built-in card remains unchanged in the source data.</div>
                <div id="editPreviewContainer"></div>
                ${showFolderPicker ? `<div class="add-word-field"><label>Folder — optional</label><select class="add-word-input" id="editFolderId">
                  <option value="">No folder</option>
                  ${customFolders.map(f => `<option value="${f.id}" ${card.folderId===f.id?'selected':''}>📁 ${escHtml(f.name)}</option>`).join('')}
                </select></div>` : ''}
                ${isExtraCard ? `<div class="add-word-field">
                  <label>Card type</label>
                  <div class="add-word-sub" id="editTypeLockNote" style="margin:-2px 0 2px;display:${(showFolderPicker && card.folderId) ? 'block':'none'};">Set by the selected folder — change the folder above to pick a different type.</div>
                  <div class="dir-option-grid" id="editTypeChips" style="${(showFolderPicker && card.folderId) ? 'opacity:.55;pointer-events:none;' : ''}">${cardTypeChipsHtml(selectedType)}</div>
                </div>` : ''}
                <div id="editFieldsContainer">${cardTypeFieldsHtml(selectedType, 'edit', v, mediaTextNow())}</div>
                <div class="add-word-actions">
                  <button class="btn-ghost" id="cancelEditCard" style="margin:0;">Cancel</button>
                  <button class="btn-main" id="saveEditCard" style="margin:0;">Save Changes</button>
                </div>
              </div>`;
            document.body.appendChild(modal);
            const q=id=>document.getElementById(id);
            let editPreviewRefresh = null;

            function wireFields() {
                if (q('pickeditImg')) q('pickeditImg').onclick=async()=>{const d=await pickDeviceFile('image/*');if(!d)return;draftImg=d;removeImg=false;q('editImgStatus').textContent='Image selected';q('editImgPreview').src=d;q('editImgPreview').style.display='block';};
                if (q('removeeditImg')) q('removeeditImg').onclick=()=>{draftImg=null;removeImg=true;q('editImgStatus').textContent='No image selected';q('editImgPreview').removeAttribute('src');q('editImgPreview').style.display='none';};
                if (q('pickeditAudio')) q('pickeditAudio').onclick=async()=>{const d=await pickDeviceFile('audio/*');if(!d)return;draftAudio=d;removeAudio=false;q('editAudioStatus').textContent='Audio selected';};
                if (q('removeeditAudio')) q('removeeditAudio').onclick=()=>{draftAudio=null;removeAudio=true;q('editAudioStatus').textContent='No audio selected';};
                if (q('editIpaUS')) q('editIpaUS').onclick=async()=>{await autoFillIPA(q('editIpa'), q('editEn'), 'us', q('editIpaUS')); if(editPreviewRefresh) editPreviewRefresh();};
                if (q('editIpaUK')) q('editIpaUK').onclick=async()=>{await autoFillIPA(q('editIpa'), q('editEn'), 'uk', q('editIpaUK')); if(editPreviewRefresh) editPreviewRefresh();};
                if (q('editGenerateAudioBtn')) q('editGenerateAudioBtn').onclick=()=>generateAudioForDraft(q('editEn'), q('editAudioStatus'), (dataUrl)=>{draftAudio=dataUrl;removeAudio=false;}, q('editGenerateAudioBtn'));
                if (q('editGenSourceToggle')) initGenSourceDropdown(q('editGenSourceToggle'), q('editGenSourceDropdown'));
                if (q('editPos')) initPosDropdown(q('editPos'), q('editPosToggle'), q('editPosDropdown'));
                if (q('pickeditAudioFront')) {
                    q('pickeditAudioFront').onclick=async()=>{const d=await pickDeviceFile('audio/*');if(!d)return;draftAudioFront=d;removeAudioFront=false;q('editAudioFrontStatus').textContent='Audio selected';};
                    q('removeeditAudioFront').onclick=()=>{draftAudioFront=null;removeAudioFront=true;q('editAudioFrontStatus').textContent='No audio selected';};
                    q('editFrontIpaUS').onclick=async()=>{await autoFillIPA(q('editFrontIpa'), q('editAr'), 'us', q('editFrontIpaUS'));};
                    q('editFrontIpaUK').onclick=async()=>{await autoFillIPA(q('editFrontIpa'), q('editAr'), 'uk', q('editFrontIpaUK'));};
                    q('editGenerateAudioFrontBtn').onclick=()=>generateAudioForDraft(q('editAr'), q('editAudioFrontStatus'), (dataUrl)=>{draftAudioFront=dataUrl;removeAudioFront=false;}, q('editGenerateAudioFrontBtn'));
                    initGenSourceDropdown(q('editGenSourceFrontToggle'), q('editGenSourceFrontDropdown'));
                    initPosDropdown(q('editFrontPos'), q('editFrontPosToggle'), q('editFrontPosDropdown'));
                }
            }
            function captureValues() {
                if (q('editAr')) v.ar = q('editAr').value.trim();
                if (q('editEn')) v.en = q('editEn').value.trim();
                if (q('editPos')) v.pos = q('editPos').value.trim();
                if (q('editIpa')) v.ipa = q('editIpa').value.trim();
                if (q('editExEn')) v.exEn = q('editExEn').value.trim();
                if (q('editExAr')) v.exAr = q('editExAr').value.trim();
                if (q('editFrontPos')) v.frontPos = q('editFrontPos').value.trim();
                if (q('editFrontIpa')) v.frontIpa = q('editFrontIpa').value.trim();
                if (q('editFrontExEn')) v.frontExEn = q('editFrontExEn').value.trim();
                if (q('editFrontExAr')) v.frontExAr = q('editFrontExAr').value.trim();
            }
