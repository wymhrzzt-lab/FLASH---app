{ n: 443, id: 'en-c2-443', en: 'effusive', ar: 'مفرط في التعبير عن المشاعر', pos: 'adj', ipa:'🇺🇸 /ˈɛfjuːsɪv/ 🇬🇧 /ɪˈfjuːsɪv/', exEn: "The author's characterization of the episode as effusive is carefully qualified by several pieces of contrary evidence.", exAr: 'تبدو النتيجة مفرط في التعبير عن المشاعر للوهلة الأولى، لكن الوثائق اللاحقة تضيف قيودًا مهمة.'}
                      
                    // === ENGLISH A1 END ===
                ],
                A2: [],
                B1: [],
                B2: [],
                C1: [],
                C2: [],
                Extra: []
            },
            Dutch: {
                A1: [],
                A2: [],
                B1: [],
                B2: [],
                C1: [],
                C2: [],
                Extra: []
            }
        };

        /* ========================================================================= SCHEDULING ========================================================================= */
        const MIN = 60 * 1000,
            DAY = 24 * 60 * MIN;

        function now() { return Date.now(); }

        function getStudyDay() {
            const d = new Date();
            if (d.getHours() < (settings.resetHour ?? 4)) {
                d.setDate(d.getDate() - 1);
            }
            // Build the date string from LOCAL components (not toISOString, which is UTC
            // and could roll the date back an extra day for positive UTC offsets).
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function addDaysToDayString(dayStr, delta) {
            const d = new Date(dayStr + 'T00:00:00Z');
            d.setUTCDate(d.getUTCDate() + delta);
            return d.toISOString().slice(0, 10);
        }

        // Tracks consecutive-day study streaks using stats.lastStreakDate / stats.streak.
        function updateStreak() {
            const today = getStudyDay();
            if (stats.lastStreakDate === today) return;
            const yesterday = addDaysToDayString(today, -1);
            stats.streak = (stats.lastStreakDate === yesterday) ? (stats.streak || 0) + 1 : 1;
            stats.lastStreakDate = today;
        }

        function freshState() { return { stage: 'new', ease: 2.5, interval: 0, reps: 0, due: now() }; }

        // Interval fuzzing: adds a small random offset (±5%) to review intervals of 3+ days
        // so that cards answered together don't keep piling up on the exact same future day.
        function fuzzDays(days) {
            if (!days || days < 3) return days;
            const pct = 0.05;
            const delta = days * pct;
            const fuzzed = days + (Math.random() * 2 - 1) * delta;
            return Math.max(1, Math.round(fuzzed));
        }

        function graduate(rating, ease) {
            let e = ease || 2.5,
                interval;
            if (rating === 'hard') { interval = 1;
                e = Math.max(1.3, e - 0.15); } else if (rating === 'good') { interval = 1; } else { interval = fuzzDays(
                    settings.easyDays || 4);
                e = e + 0.15; }
            return { stage: 'review', ease: e, interval, reps: 1, due: now() + interval * DAY };
        }

        function nextState(card, rating) {
            let st = progress[card.id] || freshState();
            st = { ...st };
            if (st.stage !== 'review') {
                if (rating === 'again') return { stage: 'new', ease: st.ease || 2.5, interval: 0, reps: 0, due: now() +
                    1 * MIN, relearn: !!st.relearn };
                if (st.stage === 'new') {
                    if (rating === 'hard') return { ...st, stage: 'hard1', due: now() + 6 * MIN };
                    if (rating === 'good') return { ...st, stage: 'good1', due: now() + 10 * MIN };
                    if (rating === 'easy') return graduate('easy', st.ease);
                }
                if (st.stage === 'hard1') return graduate(rating, st.ease);
                if (st.stage === 'good1') {
                    if (rating === 'good') return { ...st, stage: 'good2', due: now() + 1 * DAY };
                    return graduate(rating, st.ease);
                }
                if (st.stage === 'good2') return graduate(rating, st.ease);
                return st;
            } else {
                // A lapse from review sends the card back through the learning steps, but it's tracked as
                // "relearning" (not brand new) for stats purposes until it graduates back to review.
                if (rating === 'again') return { stage: 'new', ease: Math.max(1.3, st.ease - 0.2), interval: 0, reps: 0,
                    due: now() + 1 * MIN, relearn: true };
                if (rating === 'hard') { const ease = Math.max(1.3, st.ease - 0.15);
                    const interval = fuzzDays(Math.max(1, Math.round((st.interval || 1) * 1.2))); return { stage: 'review', ease,
                        interval, reps: st.reps + 1, due: now() + interval * DAY }; }
                if (rating === 'good') { const interval = fuzzDays(Math.round(st.interval * st.ease) || 2); return { stage: 'review',
                        ease: st.ease, interval, reps: st.reps + 1, due: now() + interval * DAY }; }
                if (rating === 'easy') { const ease = st.ease + 0.15;
                    const interval = fuzzDays(Math.round(st.interval * ease * 1.3) || (settings.easyDays || 4)); return { stage: 'review',
                        ease, interval, reps: st.reps + 1, due: now() + interval * DAY }; }
            }
        }

        function fmtDelay(card, rating) {
            const st = nextState(card, rating);
            const diffMs = st.due - now();
            if (diffMs < 60 * MIN) { const m = Math.round(diffMs / MIN); return m <= 1 ? '1 min' : m + ' min'; }
            const d = Math.round(diffMs / DAY);
            return d <= 1 ? '1 day' : d + ' days';
        }

        /* ========================================================================= STATE & BACKUP ========================================================================= */
        let screen = 'language';
        let lang = 'English',
            level = 'A1';
        let progress = {},
            settings = { newPerDay: 20, sessionSize: 30, easyDays: 4, resetHour: 4, timerSeconds: 10, ttsProvider: 'puter',
                voiceRssKey: '', elevenLabsKey: '', voiceAiKey: '', autoPlayAudio: false };
        let stats = { lastDate: '', introducedToday: 0, reviewedIds: [], streak: 0, lastStreakDate: '' };
        let queue = [],
            qIndex = 0,
            flipped = false,
            hasFlippedOnce = false;
        let timerVal = 10,
            timerInterval = null,
            sessionReviewed = 0,
            lastSnapshot = null,
            isRating = false;

        // Global AR<->EN study direction — deliberately NOT part of `settings`
        // (which is reloaded per language/level via loadLevelData). This flag
        // lives in its own localStorage key so it applies everywhere, for every
        // card (including ones nobody customized), and survives switching decks.
        let studyDirection = (function () {
            try { return localStorage.getItem('ui-study-direction') === 'en2ar' ? 'en2ar' : 'ar2en'; }
            catch (e) { return 'ar2en'; }
        })();
        function isEn2Ar() { return studyDirection === 'en2ar'; }
        function toggleStudyDirection() {
            studyDirection = isEn2Ar() ? 'ar2en' : 'en2ar';
            try { localStorage.setItem('ui-study-direction', studyDirection); } catch (e) {}
        }
        function studyDirLabel() { return isEn2Ar() ? '🇬🇧→🇸🇦' : '🇸🇦→🇬🇧'; }

        // Asks the user to confirm before swapping which side (Arabic or
        // English) is the question on every card, then persists the choice
        // (toggleStudyDirection already saves it to localStorage) and runs
        // the given callback to re-render the current screen.
        function confirmSwapDirection(onConfirm) {
            const goingTo = isEn2Ar()
                ? 'Arabic word on the front, English on the back (original)'
                : 'English word on the front, Arabic on the back (swapped)';
            showConfirmModal(
                'Swap Front & Back?',
                'This swaps the front and back content of every card.<br><br><b style="color:var(--text);">New layout:</b> ' + goingTo,
                () => { toggleStudyDirection();
                    if (typeof onConfirm === 'function') onConfirm(); },
                'Swap',
                '⇄',
                'var(--blue)'
            );
        }

        // Builds the front word + back identity/secondary blocks for a card
        // according to the current global study direction, so flipping the
        // direction instantly changes what's asked and what's answered for
        // EVERY card everywhere (Study screen + Browse modal), even ones that
        // were never customized.
        // Builds the "rich" word block (word/expression + POS + IPA, stacked
        // vertically) used on whichever side is currently the English side.
        // The word comes first, POS sits BELOW the word (its own fixed
        // line) and IPA sits below that — all are always siblings of
        // .word-freeze-boundary, never its descendants, so if the word ever
        // needs its own internal scroll (see shrinkToFit's freeze step)
        // POS/IPA are structurally guaranteed to stay put and stay visible,
        // never swept into it.
        // Generic version: builds a rich word block (word [+POS below]
        // [+IPA below that]) from explicit word/pos/ipa values, rather than
        // always reading card.en/card.pos/card.ipa. This lets the SAME
        // markup/sizing logic be reused for a folder's front side too
        // (see the 'en2en' branch of buildCardFaceHtml), not just the
        // English/back side.
        function buildRichWordHtmlFrom(word, pos, ipa, hasExample) {
            const wordMax = wordFontMaxFor(pos, ipa, hasExample);
            return `
                ${word ? `<div class="word-freeze-boundary"><div class="en-word auto-fit-text" data-fit-role="word" data-fit-max="${wordMax}" data-fit-min="${WORD_FONT_MIN}">${escHtml(word)}</div></div>` : ''}
                ${pos ? `<div class="pos-inline">(${escHtml(pos)})</div>` : ''}
                ${ipa ? renderIPA(ipa) : ''}
            `;
        }
        function buildRichWordHtml(card, hasExample) {
            return buildRichWordHtmlFrom(card.en, card.pos, card.ipa, hasExample);
        }

        // Builds the example-sentence block (English sentence + Arabic
        // translation) shared by both faces. `extraClass` just controls the
        // spacing modifier so it fits wherever it lands (see .front-example /
        // .back-example) — the block itself is identical either way.
        function buildExampleBlockHtmlFrom(exEn, exAr, extraClass) {
            if (!exEn && !exAr) return '';
            return `<div class="example ${extraClass}">${exEn ? `<div class="en-ex auto-fit-text" data-fit-role="support" data-fit-max="13.5" data-fit-min="${SUPPORT_FONT_MIN}">${escHtml(exEn)}</div>` : ''}${exAr ? `<div class="ar-ex rtl auto-fit-text" data-fit-role="support" data-fit-max="12.5" data-fit-min="${SUPPORT_FONT_MIN}">${escHtml(exAr)}</div>` : ''}</div>`;
        }
        function buildExampleBlockHtml(card, extraClass) {
            return buildExampleBlockHtmlFrom(card.exEn, card.exAr, extraClass);
        }

        // A card's front/back direction is normally the global AR<->EN toggle,
        // but a card filed into an Extra folder uses that folder's own
        // setting instead (see the "Folders" feature in the Extra level).
        function cardDirection(card) {
            // A card carries its OWN frozen layout (set the moment it was
            // added to — or moved into — a folder, see saveAddWord /
            // showEditCardModal). That way, changing a folder's settings
            // later only changes what NEW cards get; existing cards keep
            // whatever layout they were saved with. Only cards saved before
            // this existed (no card.direction yet) fall back to reading the
            // folder's current setting live.
            if (card && card.direction) return card.direction;
            const folder = folderFor(card);
            if (folder && folder.direction) return folder.direction;
            return isEn2Ar() ? 'en2ar' : 'ar2en';
        }

        function buildCardFaceHtml(card) {
            const direction = cardDirection(card);
            // Whether the English side has an example attached — needed up
            // front so buildRichWordHtml can pick the right size tier
            // (T1..T4) regardless of which face the English group ends up on.
            const hasExample = !!(card.exEn || card.exAr);

            if (direction === 'image') {
                // Image-only front: the picture alone is the question, and
                // both languages are revealed together on the back — so the
                // example stays on the back with them.
                const parts = [];
                if (card.ar) parts.push(`<div class="word-freeze-boundary"><div class="ar-word auto-fit-text rtl" data-fit-role="word" data-fit-max="${WORD_FONT_MAX}" data-fit-min="${WORD_FONT_MIN}">${escHtml(card.ar)}</div></div>`);
                if (card.en || card.pos || card.ipa) parts.push(buildRichWordHtml(card, hasExample));
                return { frontWordHtml: '', frontShowSpeak: false, backIdentityHtml: parts.join(''), backShowSpeak: true, backSecondaryHtml: '', imageOnlyFront: true, frontExampleHtml: '', backExampleHtml: buildExampleBlockHtml(card, 'back-example') };
            }

            if (direction === 'image-back') {
                // Mirror of 'image': both words are revealed together up
                // front, and the picture alone is saved for the back as the
                // "answer" — for folders built around a photo as the payoff
                // rather than the prompt.
                const parts = [];
                if (card.ar) parts.push(`<div class="word-freeze-boundary"><div class="ar-word auto-fit-text rtl" data-fit-role="word" data-fit-max="${WORD_FONT_MAX}" data-fit-min="${WORD_FONT_MIN}">${escHtml(card.ar)}</div></div>`);
                if (card.en || card.pos || card.ipa) parts.push(buildRichWordHtml(card, hasExample));
                return { frontWordHtml: parts.join(''), frontShowSpeak: true, backIdentityHtml: '', backShowSpeak: false, backSecondaryHtml: '', frontExampleHtml: buildExampleBlockHtml(card, 'front-example'), backExampleHtml: '' };
            }

            if (direction === 'en2en') {
                // Both faces in English — e.g. opposites/synonyms. Unlike
                // every other direction, NEITHER side is "the Arabic word";
                // both are just words, so both get the full rich treatment
                // (category + IPA + example + their own audio) instead of
                // one side being plain text. The "Arabic" field is reused
                // as the front word, rendered LTR, with its own frontPos/
                // frontIpa/frontExEn/frontExAr/audioFront — all optional.
                const hasFrontExample = !!(card.frontExEn || card.frontExAr);
                const frontIdentityHtml = buildRichWordHtmlFrom(card.ar, card.frontPos, card.frontIpa, hasFrontExample);
                const backIdentityHtml = buildRichWordHtml(card, hasExample);
                return {
                    frontWordHtml: frontIdentityHtml, frontShowSpeak: true, frontAudioKey: 'audioFront',
                    frontIds: { removeAudio: 'removeAudioBtnFront', generateAudio: 'generateAudioBtnFront', genCaret: 'genSourceCaretBtnFront', addAudio: 'addAudioBtnFront' },
                    frontHasContent: !!(card.ar || card.frontPos || card.frontIpa || card.frontExEn || card.frontExAr),
                    backIdentityHtml, backShowSpeak: true, backSecondaryHtml: '',
                    frontExampleHtml: buildExampleBlockHtmlFrom(card.frontExEn, card.frontExAr, 'front-example'),
                    backExampleHtml: buildExampleBlockHtml(card, 'back-example')
                };
            }

            if (direction === 'en2ar') {
                // Swapped: the whole English group (word + POS + IPA) moves to
                // the front as the question; the back only holds the Arabic
                // translation — never the English word again. The example
                // sentence belongs with the English word, so it travels to
                // the front with it instead of staying pinned to "the back".
                const frontWordHtml = card.en ? buildRichWordHtml(card, hasExample) : '';
                const backIdentityHtml = card.ar
                    ? `<div class="word-freeze-boundary"><div class="ar-word auto-fit-text rtl" data-fit-role="word" data-fit-max="${WORD_FONT_MAX}" data-fit-min="${WORD_FONT_MIN}">${escHtml(card.ar)}</div></div>`
                    : '';
                return { frontWordHtml, frontShowSpeak: true, backIdentityHtml, backShowSpeak: false, backSecondaryHtml: '', frontExampleHtml: buildExampleBlockHtml(card, 'front-example'), backExampleHtml: '' };
            }
            // Default: the Arabic word/expression is the question on the
            // front; the English group (word + POS + IPA) is the answer on
            // the back. The Arabic word is never repeated on the back, and
            // the example (which belongs with the English word) stays here too.
            const frontWordHtml = card.ar
                ? `<div class="word-freeze-boundary"><div class="ar-word front-word auto-fit-text rtl" data-fit-max="${WORD_FONT_MAX}" data-fit-min="${WORD_FONT_MIN}" data-fit-role="word">${escHtml(card.ar)}</div></div>`
                : '';
            const backIdentityHtml = buildRichWordHtml(card, hasExample);
            return { frontWordHtml, frontShowSpeak: false, backIdentityHtml, backShowSpeak: true, backSecondaryHtml: '', frontExampleHtml: '', backExampleHtml: buildExampleBlockHtml(card, 'back-example') };
        }

        // ---------------------------------------------------------------
        // Face STRUCTURE builders (as opposed to buildCardFaceHtml above,
        // which only decides WHICH TEXT — Arabic vs English — goes on
        // which physical face). These two decide the surrounding
        // furniture: the photo/emoji + its Add/Change Photo button always
        // travel together with whichever content has no audio (the
        // non-English side), and the example + audio controls always
        // travel together with whichever content DOES have audio (the
        // English side) — never with "the front" or "the back" as a fixed
        // physical spot. That way, toggling the AR<->EN direction only
        // ever changes WHICH physical face shows first; the two content
        // "bundles" themselves never change shape, gain a photo they
        // didn't have, or lose the buttons they had.
        // ---------------------------------------------------------------

        // The bundle with no audio: a word (may be blank, e.g. the
        // image-direction front) + the photo/emoji + its add/change
        // button. `ids` supplies the element ids the caller's event-wiring
        // code expects (kept identical to the old hardcoded ids so nothing
        // downstream has to change).
        function buildPhotoUnitHtml(card, wordHtml, ids) {
            const hasMedia = !!(mediaFor(card.id).img || card.emo);
            const hasImg = !!mediaFor(card.id).img;
            return `
                <div class="front-content${hasMedia ? ' has-media' : ''}">
                  ${wordHtml ? `<div class="front-word-slot">
                    <div class="back-identity">${wordHtml}</div>
                  </div>` : ''}
                  ${hasMedia ? `<div class="front-media-slot"><div class="front-media-box">
                    ${hasImg ? `<div class="custom-img-wrap"><img class="custom-img" id="${ids.img}" src="${mediaFor(card.id).img}" alt=""></div>` : `<div class="emo">${escHtml(card.emo)}</div>`}
                  </div></div>` : ''}
                  <div class="front-audio-actions">
                    ${hasImg
                        ? `<button class="audio-link remove" id="${ids.removeImg}">🗑 Remove Photo</button>`
                        : `<button class="audio-link photo-link" id="${ids.addImg}">📷 Add Photo</button>`}
                  </div>
                </div>`;
        }

        // The bundle WITH audio: the identity (word [+POS][+IPA]) + example
        // + audio controls — never a photo, since the photo always lives
        // in the other bundle (see buildPhotoUnitHtml above).
        function buildRichUnitHtml(card, identityHtml, exampleHtml, showSpeak, ids, audioKey, hasContent) {
            audioKey = audioKey || 'audio';
            const hasAudio = !!mediaFor(card.id)[audioKey];
            // hasContent lets a caller override the "anything here at all?"
            // check — needed for the en2en front bundle, which has its own
            // set of fields (frontPos/frontIpa/etc.) instead of the default
            // back-side ones checked below.
            const isBlank = hasContent === undefined
                ? (!card.en && !card.pos && !card.ipa && !card.ar && !card.exEn && !card.exAr)
                : !hasContent;
            return `
                <div class="back-content">
                  <div class="back-middle">
                    <div class="back-identity${(showSpeak && hasAudio) ? ' identity-gutter' : ''}">
                      ${identityHtml}
                    </div>
                    ${exampleHtml}
                    ${isBlank ? `<div class="blank-back-note">No answer details yet</div>` : ''}
                  </div>
                  <div class="front-audio-actions back-audio-actions">
                    ${showSpeak ? (hasAudio ? `<button class="audio-link remove" id="${ids.removeAudio}">🎵 Remove Audio</button>` : `<span class="gen-btn-group"><button class="audio-link gen-main" id="${ids.generateAudio}" style="color:var(--amber);background:rgba(224,167,66,.12);border-color:rgba(224,167,66,.35);">✨ Generate</button><button class="gen-source-caret" id="${ids.genCaret}">▾</button></span><button class="audio-link" id="${ids.addAudio}">+ Add Audio</button>`) : ''}
                  </div>
                </div>`;
