                delete progress[id];
                delete customMedia[id];
                try { localStorage.removeItem(CUSTOM_WORDS_PREFIX + 'deleted-' + id); } catch (e) {}
            }
            await saveProgress();
            await idbSet(keyMedia(), customMedia);
            return true;
        }

