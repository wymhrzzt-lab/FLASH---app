        let _audioPlayer = null;

        // Stops whatever custom audio clip is currently playing (if any).
        // Called on every point where audio must not keep going: flipping
        // the card (either direction), closing the study card or the
        // browse modal, and navigating to ANY other screen (including back
        // to the language-select screen). Safe to call even if nothing is
        // playing.
        function stopCustomAudio() {
            if (_audioPlayer) {
                try { _audioPlayer.pause(); } catch (e) {}
                try { _audioPlayer.currentTime = 0; } catch (e) {}
            }
            if (window.speechSynthesis) { try { speechSynthesis.cancel(); } catch (e) {} }
        }
        // Belt-and-suspenders: if the user switches away from the tab/app
        // (or the page is being unloaded) while a clip is playing, stop it
        // too — not just on in-app navigation.
        document.addEventListener('visibilitychange', () => { if (document.hidden) stopCustomAudio(); });
        window.addEventListener('pagehide', stopCustomAudio);

        async function playCustomAudio(url) {
            try {
                const source = String(url || '').trim();
                if (!source) {
                    lastGenerateError = 'Audio playback failed: empty audio source';
                    return false;
                }

                if (!_audioPlayer) {
                    _audioPlayer = new Audio();
                    _audioPlayer.preload = 'auto';
                }

                _audioPlayer.pause();
                _audioPlayer.currentTime = 0;
                _audioPlayer.src = source;
                _audioPlayer.load();

                const p = _audioPlayer.play();
                if (p && p.catch) await p;

                return true;
            } catch (e) {
                lastGenerateError = 'Audio playback failed: ' + String(e && e.message ? e.message : e);
                return false;
            }
        }
        // ============================================================
        // FETCHING AUDIO - robust, resumable, live UI
        // ============================================================
        const FETCH_STATE_PREFIX = 'audio-fetch-state-v2-';
        let fetchRuntime = null;

        function fetchStateKey() { return FETCH_STATE_PREFIX + slug(); }

        function defaultFetchState() {
            return {
                status: 'idle',
                selectedIds: [],
                processedIds: [],
                successIds: [],
                failedIds: [],
                skippedIds: [],
                currentId: null,
                summary: null,
                startedAt: null,
                finishedAt: null
            };
        }

        function loadFetchState() {
            try {
                const v = localStorage.getItem(fetchStateKey());
                if (!v) return defaultFetchState();
                const st = { ...defaultFetchState(), ...JSON.parse(v) };
                for (const k of ['selectedIds', 'processedIds', 'successIds', 'failedIds', 'skippedIds'])
                    if (!Array.isArray(st[k])) st[k] = [];
                return st;
            } catch (e) { return defaultFetchState(); }
        }

        function saveFetchState(st) { try { localStorage.setItem(fetchStateKey(), JSON.stringify(st)); } catch (e) {} }

        function fetchCardById(id) { return CARDS().find(c => c.id === id) || null; }

        function fetchAllIds() { return CARDS().map(c => c.id); }

        function normalizeFetchState(st) {
            const all = fetchAllIds();
            const selected = new Set(st.selectedIds);
            for (const id of all)
                if (!selected.has(id)) st.selectedIds.push(id);

            const buckets = ['successIds', 'failedIds', 'skippedIds'];
            const owner = new Set();
            for (const key of buckets) {
                st[key] = st[key].filter(id => all.includes(id) && !owner.has(id) && (owner.add(id), true));
            }

            if (st.status === 'running' || st.status === 'complete') {
                for (const id of st.selectedIds) {
                    if (!st.processedIds.includes(id) && audioAttached(fetchCardById(id))) {
                        st.processedIds.push(id);
                        if (!st.skippedIds.includes(id)) st.skippedIds.push(id);
                    }
                }
            }
            if (st.status === 'complete') st.summary = fetchStatsFromState(st);
            return st;
        }

        function escHtml(v) { return String(v ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;',
                '"': '&quot;', "'": '&#39;' } [m])); }

        // Formats IPA without letting long US/UK pronunciations collide with the audio button.
        function renderIPA(value) {
            const raw = String(value ?? '').trim();
            if (!raw) return '';

            const re = /(🇺🇸|🇺🇲|🇬🇧)\s*(\/[^/]+\/)/gu;
            const matches = [...raw.matchAll(re)];

            if (matches.length) {
                return `<div class="ipa-stack">${matches.map(m => {
                    const flagSvg = m[1] === '🇬🇧' ? FLAG_SVG_UK : FLAG_SVG_US;
                    return `<div class="ipa-line"><span class="ipa-flag">${flagSvg}</span><span class="ipa-text auto-fit-text" data-fit-role="support" data-fit-max="14" data-fit-min="${SUPPORT_FONT_MIN}">${escHtml(m[2])}</span></div>`;
                }).join('')}</div>`;
            }

            return `<div class="ipa single-ipa auto-fit-text" data-fit-role="support" data-fit-max="14" data-fit-min="${SUPPORT_FONT_MIN}">/${escHtml(raw)}/</div>`;
        }

        // Normalizes what's typed/inserted in the IPA field before saving.
        // Flag-tagged entries (🇺🇸 /.../ or 🇬🇧 /.../) must keep BOTH slashes intact so renderIPA's stack parser can find them.
        // Plain legacy entries keep the old behavior: slashes are stripped here and re-added by renderIPA at display time.
        function normalizeIpaInput(value) {
            const raw = String(value ?? '').trim();
            if (!raw) return '';
            if (/🇺🇸|🇺🇲|🇬🇧/u.test(raw)) return raw;
            return raw.replace(/^\/+|\/+$/g, '');
        }

        // Inserts a "🇺🇸 //" or "🇬🇧 //" template into an IPA input at the cursor, leaving the cursor between the slashes.
        function insertIpaFlagTemplate(inputEl, flag) {
            if (!inputEl) return;
            const template = flag + ' //';
            const start = inputEl.selectionStart ?? inputEl.value.length;
            const end = inputEl.selectionEnd ?? inputEl.value.length;
            const before = inputEl.value.slice(0, start);
            const after = inputEl.value.slice(end);
            const sep = (before && !/\s$/.test(before)) ? ' ' : '';
            inputEl.value = before + sep + template + after;
            inputEl.focus();
            const cursor = (before + sep + flag + ' /').length;
            inputEl.setSelectionRange(cursor, cursor);
        }

        function cleanAudioCandidates(word) {
            const raw = String(word || '').trim();
            const cleaned = raw.replace(/\([^)]*\)/g, ' ').replace(/[^a-zA-Z0-9' /-]/g, ' ').replace(/\s+/g, ' ').trim();
            const out = [];
            const add = x => { x = String(x || '').trim(); if (x && !out.includes(x)) out.push(x); };
            add(cleaned);
            cleaned.split(/\s*\/\s*/).forEach(add);
            if (/^to\s+/i.test(cleaned)) add(cleaned.replace(/^to\s+/i, ''));
            const firstWord = cleaned.match(/[A-Za-z]+(?:'[A-Za-z]+)?/);
            if (firstWord) add(firstWord[0]);
            return out;
        }

        function scoreAudioUrl(url) {
            const u = String(url || '').toLowerCase();
            let s = 0;
            if (/(?:^|[-_])(us|en-us)(?:[-_.]|$)/.test(u)) s += 50;
            if (u.includes('gstatic.com/dictionary/static/sounds')) s += 10;
            if (/(?:uk|gb)/.test(u)) s -= 5;
            return s;
        }

        async function fetchWithTimeout(url, options = {}, ms = 15000) {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), ms);
            try { return await fetch(url, { ...options, signal: ctrl.signal, cache: 'no-store' }); } finally { clearTimeout(
                    timer); }
        }

        // ============================================================
        // AUTO-IPA — one tap on a flag fills in the real transcription.
        // US flag  -> American IPA.
        // UK flag  -> British IPA, scraped straight from Cambridge Dictionary
        //             (dictionary.cambridge.org), NOT the Oxford system.
        // Falls back to the (CORS-friendly) Free Dictionary API only if Cambridge
        // can't be reached, so a flag tap always tries to produce something usable
        // without the user ever leaving the app.
        // ============================================================
        const _ipaCache = {}; // lowercased word -> { us, uk, source }

        // Public CORS proxies, tried in order. Cambridge's own server has no
        // Access-Control-Allow-Origin header, so a direct fetch() from the page is
        // always blocked by the browser — one of these has to relay it.
        const IPA_CORS_PROXIES = [
            u => 'https://api.allorigins.win/raw?url=' + encodeURIComponent(u),
            u => 'https://corsproxy.io/?url=' + encodeURIComponent(u),
            u => 'https://proxy.cors.sh/' + u
        ];

        // Races all CORS proxies at once instead of trying them one after another
        // (was up to 45s worst-case sequential) — whichever proxy answers first
        // with usable HTML wins, so this settles as fast as the fastest proxy.
        async function fetchCambridgeHtml(term) {
            const slug = term.toLowerCase().trim().replace(/\s+/g, '-');
            if (!slug) return null;
            const target = 'https://dictionary.cambridge.org/dictionary/english/' + encodeURIComponent(slug);
            const attempts = IPA_CORS_PROXIES.map(async (buildProxyUrl) => {
                const res = await fetchWithTimeout(buildProxyUrl(target), {
                    headers: { 'Accept': 'text/html' }
                }, 9000);
                if (!res.ok) throw new Error('bad status');
                const html = await res.text();
                if (html && html.length > 500 && /dpron-i/.test(html)) return html;
                throw new Error('unusable html');
            });
            try { return await Promise.any(attempts); } catch (e) { return null; }
        }

        // Pulls the US/UK IPA strings out of a Cambridge Dictionary page. Cambridge
        // marks each accent's pronunciation block with class="uk dpron-i" / "us dpron-i",
        // and the transcription itself sits in a nearby class="ipa dipa ..." span.
        function extractCambridgeIPA(html) {
            function grab(accent) {
                const blockRe = new RegExp('class="[^"]*\\b' + accent + '\\b[^"]*\\bdpron-i\\b[^"]*"', 'i');
                const blockMatch = blockRe.exec(html);
                if (!blockMatch) return null;
                const windowHtml = html.slice(blockMatch.index, blockMatch.index + 1800);
                const ipaMatch = /class="[^"]*\bipa\b[^"]*"[^>]*>([^<]+)</i.exec(windowHtml);
                if (!ipaMatch) return null;
                return ipaMatch[1].replace(/\//g, '').replace(/\s+/g, ' ').trim() || null;
            }
            return { uk: grab('uk'), us: grab('us') };
        }

        // Fallback source when Cambridge can't be reached — the same Free Dictionary
        // API this app already uses for offline audio, which does allow CORS.
        async function fetchFreeDictionaryIPA(term) {
            try {
                const res = await fetchWithTimeout(
                    'https://api.dictionaryapi.dev/api/v2/entries/en/' + encodeURIComponent(term), {}, 8000);
                if (!res.ok) return null;
                const data = await res.json();
                if (!Array.isArray(data)) return null;
                let generic = null, us = null, uk = null;
                for (const entry of data) {
                    for (const p of (entry && Array.isArray(entry.phonetics) ? entry.phonetics : [])) {
                        const text = String(p && p.text || '').replace(/\//g, '').trim();
                        if (!text) continue;
                        const audio = String(p && p.audio || '').toLowerCase();
                        if (!generic) generic = text;
                        if (!us && /-us\.|_us\.|\bus\b/.test(audio)) us = text;
                        if (!uk && /-uk\.|_uk\.|\buk\b|\bgb\b/.test(audio)) uk = text;
                    }
                }
                if (!us && !uk && !generic) return null;
                return { us: us || generic, uk: uk || generic };
            } catch (e) { return null; }
        }

        // Looks up both accents for a word in one go and caches the result for the
        // session, so tapping the other flag right after is instant.
        //
        // Speed-up: Cambridge (all candidate spellings, each racing all CORS
        // proxies) and the Free Dictionary fallback now fire CONCURRENTLY
        // instead of sequentially, and we take whichever source resolves with
        // real data first via Promise.any. This cuts typical lookup time from
        // ~12-15s down to a couple of seconds — as fast as the quicker source.
        async function fetchIpaForWord(word) {
            const key = String(word || '').trim().toLowerCase();
            if (!key) return { us: null, uk: null, source: null };
            if (_ipaCache[key]) return _ipaCache[key];

            const candidates = cleanAudioCandidates(word);

            const cambridgeAttempt = (async () => {
                for (const term of candidates) {
                    const html = await fetchCambridgeHtml(term);
                    if (!html) continue;
                    const ex = extractCambridgeIPA(html);
                    if (ex.us || ex.uk) return { us: ex.us, uk: ex.uk, source: 'cambridge' };
                }
                throw new Error('no cambridge ipa');
            })();

            const freeDictAttempt = (async () => {
                for (const term of candidates) {
                    const ex = await fetchFreeDictionaryIPA(term);
                    if (ex && (ex.us || ex.uk)) return { us: ex.us, uk: ex.uk, source: 'freedictionary' };
                }
                throw new Error('no freedictionary ipa');
            })();

            let result = { us: null, uk: null, source: null };
            try {
                result = await Promise.any([cambridgeAttempt, freeDictAttempt]);
            } catch (e) { /* both sources failed to find anything */ }

            _ipaCache[key] = result;
            return result;
        }

        // Merges a freshly generated IPA string into the input, keeping whatever the
        // other flag already produced (so tapping US then UK builds up "🇺🇸 /.../ 🇬🇧 /.../").
        function setIpaForFlag(inputEl, flagEmoji, ipaText) {
            if (!inputEl) return;
            const raw = String(inputEl.value || '').trim();
            const re = /(🇺🇸|🇺🇲|🇬🇧)\s*\/([^/]*)\//gu;
            const map = {};
            let m;
            while ((m = re.exec(raw))) map[m[1] === '🇬🇧' ? 'uk' : 'us'] = m[2];
            map[flagEmoji === '🇬🇧' ? 'uk' : 'us'] = ipaText;
            const parts = [];
            if (map.us !== undefined) parts.push('🇺🇸 /' + map.us + '/');
            if (map.uk !== undefined) parts.push('🇬🇧 /' + map.uk + '/');
            inputEl.value = parts.join(' ');
        }

        // ===================== LIVE MINI PREVIEW (Add/Edit modals) =====================
        // Shows a small tap-to-flip preview of exactly how the card will look,
        // respecting the current global study direction, and updates live as the
        // user types. Used by both showAddWordModal and showEditCardModal.
        function computePreviewFaces(fields) {
            const en2ar = isEn2Ar();
            return {
                en2ar,
                frontWord: en2ar ? fields.en : fields.ar,
                frontIsAr: !en2ar,
                mainWord: en2ar ? fields.ar : fields.en,
                mainIsAr: en2ar,
                showPosIpaOnMain: !en2ar,
                pos: fields.pos,
                ipa: fields.ipa
            };
        }

        function renderMiniPreviewFace(fields) {
            const f = computePreviewFaces(fields);
            const frontHtml = f.frontWord
                ? `<div class="mini-preview-word auto-fit-text${f.frontIsAr ? ' rtl' : ''}" data-fit-role="word" data-fit-max="19">${escHtml(f.frontWord)}</div>`
                    + (f.en2ar && f.pos ? `<div class="mini-preview-pos">(${escHtml(f.pos)})</div>` : '')
                    + (f.en2ar && f.ipa ? `<div class="mini-preview-ipa">${escHtml(f.ipa)}</div>` : '')
                : `<div class="mini-preview-empty">Front is empty</div>`;
            const backHtml = f.mainWord
                ? `<div class="mini-preview-en auto-fit-text${f.mainIsAr ? ' rtl' : ''}" data-fit-role="word" data-fit-max="20">${escHtml(f.mainWord)}</div>`
                    + (f.showPosIpaOnMain && f.pos ? `<div class="mini-preview-pos">(${escHtml(f.pos)})</div>` : '')
                    + (f.showPosIpaOnMain && f.ipa ? `<div class="mini-preview-ipa">${escHtml(f.ipa)}</div>` : '')
                : `<div class="mini-preview-empty">Back is empty</div>`;
            return { frontHtml, backHtml };
        }

        function setupMiniPreview(containerId, getFields, watchInputs) {
            const container = document.getElementById(containerId);
            if (!container) return;
            let previewFlipped = false;
            container.innerHTML = `
              <div class="mini-preview-wrap">
                <div class="mini-preview-label">Live Preview — tap card to flip · ${studyDirLabel()}</div>
                <div class="mini-preview-card" id="${containerId}Card">
                  <div class="mini-preview-inner">
                    <div class="mini-preview-face mini-front" id="${containerId}Front"></div>
                    <div class="mini-preview-face mini-back" id="${containerId}Back"></div>
                  </div>
                </div>
              </div>`;
            const cardEl = document.getElementById(containerId + 'Card');
            const frontEl = document.getElementById(containerId + 'Front');
            const backEl = document.getElementById(containerId + 'Back');
            function refresh() {
                const { frontHtml, backHtml } = renderMiniPreviewFace(getFields());
                frontEl.innerHTML = frontHtml;
                backEl.innerHTML = backHtml;
                autoFitCardFaces(cardEl);
            }
            cardEl.onclick = () => { previewFlipped = !previewFlipped; cardEl.classList.toggle('flipped', previewFlipped); };
            refresh();
            (watchInputs || []).forEach(el => { if (el) el.addEventListener('input', refresh); });
            return refresh;
        }

        // Generates TTS audio straight from the Add/Edit modal — before the card
        // is even saved — using whichever provider is active (Puter.ai by default,
        // no key needed) and drops the result into the draft audio slot.
        async function generateAudioForDraft(wordInputEl, statusEl, setDraft, btnEl) {
            const word = (wordInputEl && wordInputEl.value || '').trim();
            if (!word) {
                showInfoModal('⚠️', 'Type the word first',
                    'Enter the English word above first, then generate its audio.', 'var(--hard)');
                return;
            }
            if (audioSystemBusy) {
                showInfoModal('⏳', 'Please Wait',
                    'Another audio operation (Generate or Fetching Audio) is already running. Try again once it finishes.',
                    'var(--hard)');
                return;
            }
            audioSystemBusy = true;
            const originalLabel = btnEl ? btnEl.textContent : '';
            if (btnEl) { btnEl.disabled = true; btnEl.textContent = '⏳ Generating…'; }
            lastGenerateError = '';
            let result = null;
            try { result = await fetchProviderAudio(word); }
            finally {
                audioSystemBusy = false;
                if (btnEl) { btnEl.disabled = false; btnEl.textContent = originalLabel || '✨ Generate Audio'; }
            }
            if (!result || !result.audio) {
                showInfoModal('❌', 'Generation Failed', lastGenerateError ||
                    'Could not generate audio. Check your provider settings.', 'var(--again)');
                return;
            }
            setDraft(result.audio);
            if (statusEl) statusEl.textContent = 'Audio generated ✓ (' + word + ')';
        }

        // Wired to the flag buttons in the Add/Edit card modals. Reads the English
        // word the user already typed, generates the real IPA with no external steps,
        // and drops it straight into the IPA field.
        async function autoFillIPA(inputEl, wordInputEl, accent, btnEl) {
            const word = (wordInputEl && wordInputEl.value || '').trim();
            if (!word) {
                showInfoModal('⚠️', 'Type the word first',
                    'Enter the English word above first, then tap a flag to generate its pronunciation automatically.',
                    'var(--hard)');
                return;
            }
            if (btnEl) { btnEl.disabled = true; btnEl.classList.add('loading'); }
            try {
                const result = await fetchIpaForWord(word);
                const ipa = accent === 'uk' ? result.uk : result.us;
                if (!ipa) {
                    showInfoModal('❌', 'Pronunciation not found',
                        `Couldn't find a ${accent === 'uk' ? 'British' : 'American'} pronunciation for "${word}". You can type it in manually.`,
                        'var(--again)');
                    insertIpaFlagTemplate(inputEl, accent === 'uk' ? '🇬🇧' : '🇺🇸');
                    return;
                }
                setIpaForFlag(inputEl, accent === 'uk' ? '🇬🇧' : '🇺🇸', ipa);
            } catch (e) {
                showInfoModal('❌', 'Pronunciation lookup failed',
                    'Something went wrong while generating the pronunciation. Check your internet connection and try again.',
                    'var(--again)');
            } finally {
                if (btnEl) { btnEl.disabled = false; btnEl.classList.remove('loading'); }
            }
        }

        // ===================== POS TEMPLATE DROPDOWN =====================
        // Standard part-of-speech tags for the collapsible template picker in the
        // Add/Edit Card forms. The 5 core tags (marked core:true) are shown first
        // because they cover the vast majority of words.
        const POS_TEMPLATES = [
            { tag: 'n',     label: 'noun',          core: true },
            { tag: 'v',     label: 'verb',          core: true },
            { tag: 'adj',   label: 'adjective',     core: true },
            { tag: 'adv',   label: 'adverb',        core: true },
            { tag: 'prep',  label: 'preposition',   core: true },
            { tag: 'pron',  label: 'pronoun' },
            { tag: 'conj',  label: 'conjunction' },
            { tag: 'det',   label: 'determiner' },
            { tag: 'aux',   label: 'auxiliary verb' },
            { tag: 'modal', label: 'modal verb' },
            { tag: 'interj',label: 'interjection' },
            { tag: 'num',   label: 'numeral' },
            { tag: 'phr v', label: 'phrasal verb' },
            { tag: 'idiom', label: 'idiom' },
            { tag: 'expr',  label: 'expression' }
        ];

        // Splits the plain "n/v" style value stored in the input into a lowercase tag array.
        function parsePosValue(raw) {
            return (raw || '').split('/').map(s => s.trim().toLowerCase()).filter(Boolean);
        }

        // (Re)draws the chip grid inside a POS dropdown panel, checked against the input's
        // current value, and wires each chip to toggle itself in/out of that value.
        function renderPosChips(dropdownEl, inputEl) {
            const selected = parsePosValue(inputEl.value);
            const core = POS_TEMPLATES.filter(p => p.core);
            const rest = POS_TEMPLATES.filter(p => !p.core);
            const chip = p => `<button type="button" class="pos-chip${selected.includes(p.tag) ? ' selected' : ''}" data-tag="${p.tag}" title="${p.label}">${p.tag}</button>`;
            dropdownEl.innerHTML =
                '<div class="pos-chip-group-label">Core</div>' +
                '<div class="pos-chip-grid">' + core.map(chip).join('') + '</div>' +
                '<div class="pos-chip-group-label">More</div>' +
                '<div class="pos-chip-grid">' + rest.map(chip).join('') + '</div>';
            dropdownEl.querySelectorAll('.pos-chip').forEach(btn => {
                btn.onclick = () => {
                    const tag = btn.dataset.tag;
                    const set = parsePosValue(inputEl.value);
                    const idx = set.indexOf(tag);
                    if (idx >= 0) set.splice(idx, 1); else set.push(tag);
                    // Always write back out in canonical POS_TEMPLATES order, e.g. "n/v" not "v/n".
                    inputEl.value = POS_TEMPLATES.filter(p => set.includes(p.tag)).map(p => p.tag).join('/');
                    renderPosChips(dropdownEl, inputEl);
                };
            });
        }

        // Wires the "▾ Templates" toggle button for one POS field. Free typing in the
        // input still works normally; the dropdown is just a fast way to fill/combine it.
        function initPosDropdown(inputEl, toggleBtn, dropdownEl) {
            toggleBtn.onclick = () => {
                const willOpen = !dropdownEl.classList.contains('open');
                if (willOpen) renderPosChips(dropdownEl, inputEl);
